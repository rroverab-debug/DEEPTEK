# Copy to .dev.vars for local testing with `npm run preview`. Never commit .dev.vars.
ENVIRONMENT=development
# Cloudflare's always-pass Turnstile test secret:
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Leave the email settings empty to log submissions to the console instead of sending.
EMAIL_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
