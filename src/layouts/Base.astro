---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { content, dirOf, langOf, langs, switchPath } from '../i18n';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  /** Start the page with a dark hero; the header adapts its colours. */
  darkTop?: boolean;
}

const lang = langOf(Astro.url);
const { site } = content(lang);

const {
  title,
  description = site.description,
  image = '/og.png',
  noindex = false,
  darkTop = false,
} = Astro.props;

const fullTitle = title ? `${title} | ${site.name}` : `${site.name} | ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const alternates = langs.map((l) => ({
  hreflang: l,
  href: new URL(switchPath(Astro.url.pathname, l), Astro.site ?? site.url).href,
}));
const ogImage = new URL(image, Astro.site ?? site.url).href;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.name,
  legalName: site.legalName,
  url: new URL(lang === 'ar' ? '/ar/' : '/', site.url).href,
  inLanguage: ['en', 'ar'],
  email: site.email,
  telephone: site.phone.tel,
  description: site.description,
  logo: new URL('/favicon.svg', site.url).href,
  areaServed: { '@type': 'Country', name: 'United Arab Emirates' },
  address: { '@type': 'PostalAddress', addressCountry: 'AE' },
  knowsAbout: ['IT solutions', 'Cloud infrastructure', 'Cybersecurity', 'Digital marketing', 'SEO', 'AI automation'],
  sameAs: Object.values(site.social).filter(Boolean),
};
---

<!doctype html>
<html lang={lang} dir={dirOf(lang)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline src="/js/flags.js"></script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={alternates[0].href} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#0c0c0c" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:locale:alternate" content={lang === 'ar' ? 'en_AE' : 'ar_AE'} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{lang === 'ar' ? 'انتقل إلى المحتوى' : 'Skip to content'}</a>
    <Header darkTop={darkTop} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <WhatsAppButton />
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }
</style>
