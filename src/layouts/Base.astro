---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { content, dirOf, langOf, langs, switchPath } from '../i18n';

interface Props {
  title?: string;
  /** Full search-result title; overrides the "Title | DeepTek" pattern. */
  seoTitle?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  /** Start the page with a dark hero; the header adapts its colours. */
  darkTop?: boolean;
}

const lang = langOf(Astro.url);
const { site, pillars } = content(lang);

const {
  title,
  seoTitle,
  description = site.description,
  image = '/og.png',
  noindex = false,
  darkTop = false,
} = Astro.props;

const fullTitle = seoTitle ?? (title ? `${title} | ${site.name}` : `${site.name} | ${site.tagline}`);
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const alternates = langs.map((l) => ({
  hreflang: l,
  href: new URL(switchPath(Astro.url.pathname, l), Astro.site ?? site.url).href,
}));
// Vercel Web Analytics: the script is served by Vercel itself, so only add it
// to builds that run there (it would 404 on other hosts).
const onVercel = process.env.VERCEL === '1';
const ogImage = new URL(image, Astro.site ?? site.url).href;

// Markets we target in search: the UAE first, then the wider GCC.
const gcc = ['United Arab Emirates', 'Saudi Arabia', 'Qatar', 'Kuwait', 'Bahrain', 'Oman'];
const cities = ['Dubai', 'Abu Dhabi', 'Sharjah', 'Ajman', 'Ras Al Khaimah', 'Fujairah', 'Umm Al Quwain', 'Al Ain'];
const home = new URL(lang === 'ar' ? '/ar/' : '/', site.url).href;
const orgId = new URL('/#organization', site.url).href;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': orgId,
  name: site.name,
  legalName: site.legalName,
  url: home,
  inLanguage: ['en', 'ar'],
  email: site.email,
  telephone: site.phone.tel,
  description: site.description,
  logo: new URL('/logo-mark.svg', site.url).href,
  image: new URL('/og.png', site.url).href,
  priceRange: '$$',
  areaServed: [
    ...gcc.map((name) => ({ '@type': 'Country', name })),
    ...cities.map((name) => ({ '@type': 'City', name })),
  ],
  address: { '@type': 'PostalAddress', addressCountry: 'AE', ...(site.address ? { streetAddress: site.address } : {}) },
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'sales',
    telephone: site.phone.tel,
    email: site.email,
    areaServed: ['AE', 'SA', 'QA', 'KW', 'BH', 'OM'],
    availableLanguage: ['English', 'Arabic'],
  },
  knowsAbout: [
    'IT solutions', 'Managed IT support', 'Cloud hosting', 'Microsoft 365', 'Google Workspace', 'Cybersecurity',
    'Website development', 'Digital marketing', 'SEO', 'Google Ads', 'Social media marketing',
    'AI automation', 'WhatsApp chatbots', 'Business process automation',
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: lang === 'ar' ? 'الحلول' : 'Solutions',
    itemListElement: pillars.map((p) => ({
      '@type': 'OfferCatalog',
      name: p.title,
      itemListElement: p.offerings.map((name) => ({
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', name, areaServed: gcc.map((c) => ({ '@type': 'Country', name: c })) },
      })),
    })),
  },
  sameAs: Object.values(site.social).filter(Boolean),
};

const siteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  url: home,
  inLanguage: lang,
  publisher: { '@id': orgId },
};

// Home > current page, so search results show a readable path.
const breadcrumbSchema = title && {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: lang === 'ar' ? 'الرئيسية' : 'Home', item: home },
    { '@type': 'ListItem', position: 2, name: title, item: canonical },
  ],
};
---

<!doctype html>
<html lang={lang} dir={dirOf(lang)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline src="/js/flags.js"></script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={alternates[0].href} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#0c0c0c" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:locale:alternate" content={lang === 'ar' ? 'en_AE' : 'ar_AE'} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(siteSchema)} />
    {breadcrumbSchema && !noindex && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}
    {onVercel && <script is:inline defer src="/_vercel/insights/script.js"></script>}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{lang === 'ar' ? 'انتقل إلى المحتوى' : 'Skip to content'}</a>
    <Header darkTop={darkTop} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <WhatsAppButton />
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }
</style>
