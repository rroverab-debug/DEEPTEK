---
import { content, langOf, localize } from '../i18n';

const lang = langOf(Astro.url);
const { pillars } = content(lang);
const l = (href: string) => localize(href, lang);
const t = {
  en: {
    feedLabel: 'Example of what a client’s business gets from DeepTek each day: enquiries routed and answered, backups verified, emails and reports sent, invoices filed',
    eyebrow: 'IT · Digital marketing · AI automation · UAE & GCC',
    title: 'Technology that moves your business forward.',
    lead: 'DeepTek is a technology partner for businesses across the UAE and GCC. We set up reliable IT, grow your brand online and automate the work that slows your team down, all under one accountable team.',
    primary: 'Book a free consultation',
    secondary: 'Explore solutions',
    feed: ['Your business today', 'Built by DeepTek'],
    // Illustrative updates. The card shows one batch per loop, in turn.
    batches: [
      {
        rows: [
          ['AI', 'New website enquiry routed to Sales', '09:02'],
          ['IT', 'Nightly backup verified, 42 devices', '09:15'],
          ['MKT', 'Weekly Google Ads report sent', '09:30'],
          ['AI', 'Invoice #2041 read and filed', '09:41'],
        ],
        total: ['Hours your team saved this week', 18],
      },
      {
        rows: [
          ['AI', '12 new leads received and replied to', '11:05'],
          ['MKT', 'Follow-up email sent to 340 clients', '11:20'],
          ['IT', 'Security updates on 18 laptops', '11:42'],
          ['AI', 'Tomorrow’s booking reminders sent', '12:10'],
        ],
        total: ['Enquiries answered today', 27],
      },
      {
        rows: [
          ['MKT', 'Google Business post published', '14:00'],
          ['AI', '6 supplier invoices matched', '14:25'],
          ['IT', 'Email account set up for new staff', '15:10'],
          ['AI', 'Daily sales summary sent to owner', '17:30'],
        ],
        total: ['Manual tasks automated this month', 146],
      },
    ],
  },
  ar: {
    feedLabel: 'مثال على ما تحصل عليه أعمال العميل من DeepTek كل يوم: توجيه الاستفسارات والرد عليها، والتحقق من النسخ الاحتياطي، وإرسال الرسائل والتقارير، وحفظ الفواتير',
    eyebrow: 'تقنية المعلومات · التسويق الرقمي · الأتمتة بالذكاء الاصطناعي · الإمارات والخليج',
    title: 'تقنية تدفع أعمالك إلى الأمام.',
    lead: 'DeepTek شريك تقني للشركات في الإمارات ودول الخليج. نجهّز لك تقنية معلومات موثوقة، وننمّي علامتك التجارية على الإنترنت، ونؤتمت الأعمال التي تبطئ فريقك، كل ذلك مع فريق واحد مسؤول.',
    primary: 'احجز استشارة مجانية',
    secondary: 'استكشف الحلول',
    feed: ['أعمالك اليوم', 'من تنفيذ DeepTek'],
    batches: [
      {
        rows: [
          ['AI', 'استفسار جديد وُجّه إلى المبيعات', '09:02'],
          ['IT', 'نسخ احتياطي ليلي سليم، 42 جهازاً', '09:15'],
          ['MKT', 'أُرسل تقرير إعلانات Google الأسبوعي', '09:30'],
          ['AI', 'قُرئت الفاتورة رقم 2041 وحُفظت', '09:41'],
        ],
        total: ['ساعات وفّرها فريقك هذا الأسبوع', 18],
      },
      {
        rows: [
          ['AI', '12 عميلاً محتملاً جديداً وتم الرد عليهم', '11:05'],
          ['MKT', 'أُرسلت رسالة متابعة إلى 340 عميلاً', '11:20'],
          ['IT', 'ثُبّتت التحديثات الأمنية على 18 جهازاً', '11:42'],
          ['AI', 'أُرسلت تذكيرات مواعيد الغد', '12:10'],
        ],
        total: ['استفسارات تم الرد عليها اليوم', 27],
      },
      {
        rows: [
          ['MKT', 'نُشر منشور جديد على Google', '14:00'],
          ['AI', 'طوبقت 6 فواتير موردين', '14:25'],
          ['IT', 'جُهّز بريد إلكتروني لموظف جديد', '15:10'],
          ['AI', 'أُرسل ملخص المبيعات اليومي', '17:30'],
        ],
        total: ['مهام يدوية مؤتمتة هذا الشهر', 146],
      },
    ],
  },
}[lang];
---

<section class="hero theme-night" aria-labelledby="hero-title" data-intro>
  <div class="backdrop" aria-hidden="true"></div>

  <div class="feed" data-scene role="img" aria-label={t.feedLabel}>
    <div class="feed-win" data-stage aria-hidden="true" data-batches={JSON.stringify(t.batches)}>
      <div class="feed-bar">
        <span>{t.feed[0]}</span>
        <span class="mono">{t.feed[1]}</span>
      </div>
      <ul role="list">
        {
          t.batches[0].rows.map(([k, text, time], i) => (
            <li data-step={i + 1} data-row>
              <span class="k mono">{k}</span>
              <span>{text}</span>
              <span class="t mono">{time}</span>
            </li>
          ))
        }
      </ul>
      <div class="feed-foot" data-step="5">
        <span class="mono" data-total-label>{t.batches[0].total[0]}</span>
        <b data-fx="count" data-to={t.batches[0].total[1]}>{t.batches[0].total[1]}</b>
      </div>
    </div>
  </div>

  <div class="container inner">
    <p class="eyebrow" data-reveal>{t.eyebrow}</p>

    <h1 id="hero-title" class="title" data-split="now">{t.title}</h1>

    <div class="sub">
      <p class="lead" data-reveal data-delay="0.4">{t.lead}</p>
      <div class="actions" data-reveal data-delay="0.55">
        <a class="btn" href={l('/contact/')}>{t.primary} <span class="arrow" aria-hidden="true">→</span></a>
        <a class="btn btn--ghost" href={l('/solutions/')}>{t.secondary}</a>
      </div>
    </div>

    <ul class="pillars" role="list" data-reveal-stagger>
      {
        pillars.map((p) => (
          <li>
            <a href={l(`/solutions/#${p.id}`)}>
              <span class="mono">{p.index}</span>
              <span>{p.title}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    padding-top: calc(var(--header-h) + 2rem);
  }
  .backdrop {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(to right, rgb(255 255 255 / 0.05) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(255 255 255 / 0.05) 1px, transparent 1px);
    background-size: 6rem 6rem;
    mask-image: radial-gradient(ellipse 70% 60% at 75% 35%, #000 10%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 70% 60% at 75% 35%, #000 10%, transparent 75%);
  }

  .feed {
    display: none;
  }
  @media (min-width: 80rem), (min-width: 48rem) and (orientation: portrait) {
    .feed {
      display: block;
      position: absolute;
      z-index: 1;
      top: calc(var(--header-h) + 5rem);
      inset-inline-end: max(var(--gutter), calc((100vw - var(--max)) / 2 + var(--gutter)));
      width: 23rem;
    }
  }
  .feed-win {
    display: grid;
    gap: 0.25rem;
    padding: 1.1rem 1.2rem;
    background: rgb(27 27 27 / 0.85);
    border: 1px solid var(--night-line);
    border-radius: 0.6rem;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    font-size: var(--fs-sm);
  }
  @media (max-width: 63.99rem), (hover: none) {
    .feed-win {
      background: rgb(27 27 27 / 0.97);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
  }
  .feed-bar {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--night-line);
    font-weight: 500;
  }
  .feed-bar .mono,
  .feed .t,
  .feed-foot .mono {
    color: var(--night-muted);
  }
  .feed li {
    display: grid;
    grid-template-columns: 2.6rem 1fr auto;
    gap: 0.6rem;
    align-items: baseline;
    padding-block: 0.7rem;
    border-bottom: 1px solid var(--night-line);
  }
  .feed .k {
    justify-self: start;
    padding: 0.1rem 0.4rem;
    border: 1px solid var(--night-line);
    border-radius: 0.25rem;
    font-size: 0.65rem;
  }
  .feed-foot {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-top: 0.75rem;
  }
  .feed-foot b {
    font-size: 2rem;
    font-weight: 500;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
  }

  .inner {
    position: relative;
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    padding-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }
  .title {
    font-size: var(--fs-display);
    line-height: 0.94;
    letter-spacing: -0.05em;
    max-width: 13ch;
  }
  .sub {
    display: grid;
    gap: 2rem;
    align-items: end;
  }
  @media (min-width: 56rem) {
    .sub {
      grid-template-columns: 1fr auto;
    }
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .pillars {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--night-line);
    margin-top: clamp(0.5rem, 2vw, 1.5rem);
  }
  .pillars a {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
    padding: 1.25rem 1rem 0.25rem 0;
    font-size: var(--fs-sm);
    font-weight: 500;
    text-decoration: none;
    color: var(--paper);
  }
  .pillars a:hover span:last-child {
    text-decoration: underline;
  }
  .pillars .mono {
    color: var(--night-muted);
  }
  @media (max-width: 40rem) {
    .pillars {
      grid-template-columns: 1fr;
    }
    .pillars a {
      padding-block: 0.85rem;
      border-bottom: 1px solid var(--night-line);
    }
  }
</style>
