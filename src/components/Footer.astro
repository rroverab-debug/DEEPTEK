---
import { nav, site, pillars } from '../data/site';
import Logo from './Logo.astro';

const year = new Date().getFullYear();
const social = Object.entries(site.social).filter(([, url]) => Boolean(url));
---

<footer class="site-footer theme-night">
  <div class="container">
    <div class="cols">
      <div class="col brand-col">
        <a href="/" aria-label={`${site.name} home`} class="brand"><Logo /></a>
        <p>{site.tagline}</p>
      </div>
      <nav class="col" aria-label="Footer">
        <h2 class="mono">Pages</h2>
        <ul role="list">
          <li><a href="/">Home</a></li>
          {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
      </nav>
      <div class="col">
        <h2 class="mono">Solutions</h2>
        <ul role="list">
          {pillars.map((p) => <li><a href={`/solutions/#${p.id}`}>{p.title}</a></li>)}
        </ul>
      </div>
      <div class="col">
        <h2 class="mono">Contact</h2>
        <ul role="list">
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><a href={`tel:${site.phone.tel}`}>{site.phone.display}</a></li>
          <li>
            <a href={`https://wa.me/${site.whatsapp}`} rel="noopener noreferrer" target="_blank">WhatsApp</a>
          </li>
          <li>{site.address || site.location}</li>
          {
            social.map(([name, url]) => (
              <li>
                <a href={url} rel="noopener noreferrer" target="_blank">
                  {name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="base">
      <p>
        © {year} {site.legalName}. All rights reserved.
        {site.licence.number && (
          <span class="licence">
            {' '}Trade licence {site.licence.number}
            {site.licence.authority && `, ${site.licence.authority}`}.
          </span>
        )}
      </p>
      <p><a href="/privacy/">Privacy</a></p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: clamp(3rem, 6vw, 5rem) 2rem;
  }
  .cols {
    display: grid;
    gap: 2.5rem;
    padding-block: 0 3rem;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
  }
  .brand-col {
    max-width: 22rem;
  }
  .brand {
    display: inline-flex;
    text-decoration: none;
    margin-bottom: 1rem;
  }
  .col p {
    color: var(--night-muted);
    font-size: var(--fs-sm);
  }
  .col h2 {
    color: var(--night-muted);
    font-weight: 400;
    margin-bottom: 1rem;
  }
  .col ul {
    display: grid;
    gap: 0.5rem;
    font-size: var(--fs-sm);
  }
  .col a {
    text-decoration: none;
  }
  .col a:hover {
    text-decoration: underline;
  }
  .base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--night-line);
    color: var(--night-muted);
    font-size: var(--fs-xs);
  }
</style>
