---
import { site } from '../data/site';

interface Props {
  label?: string;
  message?: string;
}
const { label = 'Chat on WhatsApp', message = 'Hello DeepTek, I would like to discuss a project.' } = Astro.props;
const href = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(message)}`;
---

<a class="wa" href={href} target="_blank" rel="noopener noreferrer" aria-label={label} data-wa>
  <svg viewBox="0 0 32 32" aria-hidden="true" focusable="false">
    <path
      d="M16 3.5A12.4 12.4 0 0 0 5.3 22.2L3.6 28.4l6.4-1.7A12.4 12.4 0 1 0 16 3.5Z"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linejoin="round"></path>
    <path
      d="M12.2 10.2c-.3-.6-.6-.6-.9-.6h-.8c-.3 0-.7.1-1 .5-.4.4-1.3 1.3-1.3 3.1s1.3 3.6 1.5 3.9c.2.2 2.6 4.1 6.4 5.6 3.2 1.2 3.8 1 4.5.9.7-.1 2.2-.9 2.5-1.8.3-.9.3-1.6.2-1.8-.1-.2-.3-.3-.7-.5l-2.5-1.2c-.3-.1-.6-.2-.8.2l-1.1 1.4c-.2.2-.4.3-.8.1-.4-.2-1.6-.6-3-1.9-1.1-1-1.9-2.2-2.1-2.6-.2-.4 0-.6.2-.8l.6-.7c.2-.2.3-.4.4-.7.1-.2.1-.5 0-.7l-1.1-2.4Z"
      fill="currentColor"></path>
  </svg>
  <span class="wa-label">{label}</span>
</a>

<style>
  .wa {
    position: fixed;
    z-index: 40;
    inset-inline-end: max(1rem, env(safe-area-inset-right, 0px));
    bottom: max(1rem, env(safe-area-inset-bottom, 0px));
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    height: 3.25rem;
    padding: 0 1.1rem 0 0.9rem;
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
    border: 1px solid #3a3a3a;
    box-shadow: 0 0.75rem 2rem -0.75rem rgb(0 0 0 / 0.5);
    text-decoration: none;
    font-size: var(--fs-sm);
    font-weight: 500;
    transition:
      transform 0.3s var(--ease),
      background-color 0.3s var(--ease);
  }
  .wa:hover {
    transform: translateY(-2px);
  }
  .wa:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
  }
  .wa svg {
    width: 1.5rem;
    height: 1.5rem;
    flex: none;
  }
  @media (max-width: 40rem) {
    .wa {
      width: 3.25rem;
      padding: 0;
      justify-content: center;
    }
    .wa-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
    }
  }
  :global(.menu-open) ~ :global(*) .wa,
  :global(body:has(.menu-open)) .wa {
    display: none;
  }
</style>
