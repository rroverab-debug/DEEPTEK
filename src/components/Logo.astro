---
// DeepTek wordmark. The mark is a simple "D" built from a square and arc.
---

<span class="logo">
  <svg class="mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
    <rect x="1" y="1" width="30" height="30" rx="6" fill="none" stroke="currentColor" stroke-width="1.5"></rect>
    <path d="M10 9h6.5c4.2 0 7.5 3 7.5 7s-3.3 7-7.5 7H10V9Z" fill="currentColor"></path>
  </svg>
  <span class="word">DeepTek</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }
  .mark {
    width: 1.75rem;
    height: 1.75rem;
  }
  .word {
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.04em;
  }
</style>
