// Inline SVG art (no photos): a top-down dish for the restaurant demo and
// three seasonal ad creatives for the campaign demo.
const dish = `<svg viewBox="0 0 120 90" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
<circle cx="18" cy="16" r="22" fill="#ffffff" opacity=".08"/>
<ellipse cx="62" cy="50" rx="34" ry="33" fill="#000" opacity=".18"/>
<circle cx="60" cy="46" r="33" fill="#fff8ee"/>
<circle cx="60" cy="46" r="27" fill="#f3e5cf"/>
<circle cx="60" cy="46" r="23" fill="#f2c14e"/>
<circle cx="52" cy="40" r="2" fill="#e8a93a"/><circle cx="67" cy="53" r="2" fill="#e8a93a"/><circle cx="50" cy="56" r="1.6" fill="#e8a93a"/>
<ellipse cx="57" cy="44" rx="9" ry="6.5" fill="#8a4b2a" transform="rotate(-20 57 44)"/>
<ellipse cx="68" cy="40" rx="7" ry="5" fill="#a0582f" transform="rotate(25 68 40)"/>
<ellipse cx="55" cy="44" rx="4" ry="2" fill="#b86e3e" transform="rotate(-20 55 44)"/>
<ellipse cx="46" cy="50" rx="3.2" ry="1.6" fill="#5f9137" transform="rotate(30 46 50)"/>
<ellipse cx="72" cy="52" rx="3.2" ry="1.6" fill="#5f9137" transform="rotate(-30 72 52)"/>
<ellipse cx="62" cy="58" rx="3" ry="1.5" fill="#6fa83f"/>
<circle cx="74" cy="46" r="3" fill="#d9452b"/><circle cx="48" cy="38" r="2.6" fill="#d9452b"/>
<path d="M76 30a7 7 0 0 1 9 9z" fill="#f7e06b"/>
<circle cx="102" cy="22" r="13" fill="#fff8ee"/><circle cx="102" cy="22" r="9.5" fill="#e7c88f"/>
<path d="M97 21q5-4 10 0" stroke="#c99a52" stroke-width="1.2" fill="none"/><circle cx="102" cy="22" r="2.2" fill="#7a9a2e"/><circle cx="99" cy="25" r="1" fill="#c0392b"/>
<circle cx="102" cy="72" r="10" fill="#fff8ee" opacity=".95"/><circle cx="102" cy="72" r="7" fill="#9c4a1c"/><circle cx="100" cy="70" r="2" fill="#c46a2a"/>
<rect x="8" y="58" width="13" height="22" rx="3" fill="#fff" opacity=".85"/><rect x="10" y="64" width="9" height="14" rx="2" fill="#b5341e"/>
</svg>`;

