<circle cx="10" cy="12" r="1.4" fill="#c8901f"/><circle cx="52" cy="40" r="1.2" fill="#c8901f"/>
</svg>`,
];

const devices = [
  ['Finance-01', 'Windows 11', 'laptop'],
  ['Sales-07', 'macOS', 'laptop'],
  ['Warehouse-03', 'Windows 11', 'laptop'],
  ['Reception-02', 'iPadOS', 'tablet'],
];
---

<div class:list={['scene', `scene--${scene}`]} data-scene role="img" aria-label={label}>
  <span class="ex" aria-hidden="true" dir={dir} lang={lang}>{t.example}</span>
  <div class="stage" data-stage aria-hidden="true" dir={dir} lang={lang}>
    {
      scene === 'website' && (
        <div class="site-wrap">
          <div class="browser" data-step="1">
            <div class="b-bar" dir="ltr">
              <span class="dots"><i /><i /><i /></span>
              <span class="url">
                <svg viewBox="0 0 10 12" class="lock"><rect x="1" y="5" width="8" height="6.5" rx="1.2" /><path d="M3 5V3.6a2 2 0 0 1 4 0V5" /></svg>
                {t.w.url}
              </span>
            </div>
            <div class="b-page">
              <div class="b-nav">
                <span class="brand">
                  <svg viewBox="0 0 20 20" class="sun"><circle cx="10" cy="10" r="4.2" />{[0, 45, 90, 135, 180, 225, 270, 315].map((a) => <rect x="9.3" y="1" width="1.4" height="3.4" rx="0.7" transform={`rotate(${a} 10 10)`} />)}</svg>
                  {t.w.brand}
                </span>
                <span class="links">{t.w.links.map((l) => <span>{l}</span>)}</span>
                <span class="lang">{t.w.lang}</span>
              </div>
              <div class="b-hero">
                <div class="b-copy">
                  <span class="w-eye" data-step="2">{t.w.eyebrow}</span>
                  <span class="headline" data-step="2">{t.w.h}</span>
                  <span class="sub" data-step="3">{t.w.sub}</span>
                  <span class="ctas">
                    <span class="cta-s" data-step="3" data-fx="pop">{t.w.book}</span>
                    <span class="cta-o" data-step="3" data-fx="pop">{t.w.menu}</span>
                  </span>
                </div>
                <span class="b-img" data-step="2" data-fx="wipe">
                  <Fragment set:html={dish} />
                </span>
              </div>
              <div class="b-cards" data-step="4">
                {t.w.items.map(([n, p, k]) => (
                  <span class="mi">
                    <span class:list={['mi-pic', `mi-pic--${k}`]} />
                    <span class="mi-t">
                      <b>{n}</b>
                      <i>{p}</i>
                    </span>
                  </span>
                ))}
              </div>
            </div>
          </div>
          <div class="phone" data-step="5" data-fx="pop">
            <span class="notch" />
            <span class="p-nav">
              <b>{t.w.brand}</b>
              <span class="burger"><i /><i /></span>
            </span>
            <span class="p-img">
              <Fragment set:html={dish} />
            </span>
            <span class="p-h">{t.w.phoneH}</span>
            <span class="cta-s">{t.w.book}</span>
          </div>
          <span class="score" data-step="6" data-fx="pop">
            <span class="ring" />
            <b data-fx="count" data-to="98">98</b>
            {t.w.speed}
          </span>
        </div>
      )
    }

    {
      scene === 'saas' && (
        <div class="win app">
          <aside class="side" data-step="1">
            <span class="logo-mark">{t.s.brand.slice(0, 1)}</span>
            <i class="on" /><i /><i /><i />
          </aside>
          <div class="app-main">
            <div class="bar">
              <span class="ttl">{t.s.title}</span>
              <span class="chip">{t.s.today}</span>
            </div>
            <div class="kpis kpis--3">
              <div class="k k--1" data-step="2">
                <span class="kl">{t.s.k[0]}</span>
                <b data-fx="count" data-to="128">128</b>
              </div>
              <div class="k k--2" data-step="2">
                <span class="kl">{t.s.k[1]}</span>
                <i>{t.s.cur}</i>
                <b data-fx="count" data-to="9840">9,840</b>
              </div>
              <div class="k k--3" data-step="2">
                <span class="kl">{t.s.k[2]}</span>
                <b data-fx="count" data-to="2">2</b>
              </div>
            </div>
            <div class="bars-wrap">
              <div class="bars" data-step="3" dir="ltr">
                {[40, 55, 48, 70, 62, 88, 76].map((_, i) => (
                  <span class={`bar-${i}`} data-fx="grow-y" />
                ))}
              </div>
              <div class="days" dir="ltr">{t.s.days.map((d) => <span>{d}</span>)}</div>
            </div>
            <ul class="appts">
              {t.s.a.map(([time, av, what, st], i) => (
                <li data-step={String(i + 4)}>
                  <span class="time">{time}</span>
                  <span class="who">
                    <span class:list={['av', `av--${i + 1}`]}>{av}</span>
                    <span class="what">{what}</span>
                  </span>
                  <span class:list={['pill', i === 0 ? 'pill--ok' : 'pill--info']}>{st}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      )
    }

    {
      scene === 'hr' && (
        <div class="win">
          <div class="bar">
            <span class="person">
              <span class="av av--big">{t.h.av}</span>
              <span class="pn">
                <b>{t.h.title}</b>
                <small>{t.h.name}</small>
              </span>
            </span>
            <span class="chip">{t.h.starts}</span>
          </div>
          <div class="progress" data-step="1">
            <span class="pl">{t.h.ready}</span>
            <span class="track">
              <span class="fill fill--75" data-fx="grow-x" />
            </span>
            <span class="pv">75%</span>
          </div>
          <ul class="checks">
            {t.h.checks.map((c, i) =>
              i < 3 ? (
                <li data-step={String(i + 2)}>
                  <span class="box" data-step={String(i + 2)} data-fx="pop">✓</span>
                  {c}
                </li>
              ) : (
                <li data-step="5" class="pending">
                  <span class="box box--empty" />
                  {c}
                </li>
              ),
            )}
          </ul>
          <div class="leave" data-step="6">
            <span class="lv-ic">
              <svg viewBox="0 0 20 20"><rect x="2.5" y="4" width="15" height="13" rx="2" /><path d="M2.5 8h15M6.5 2v4M13.5 2v4" /></svg>
            </span>
            <span class="lv-t">
              <b>{t.h.leave}</b>
              <span>{t.h.who}</span>
            </span>
            <span class="btn-s" data-step="7" data-fx="pop">{t.h.ok}</span>
          </div>
        </div>
      )
    }

    {
      scene === 'campaign' && (
        <div class="win">
          <div class="bar">
            <span class="ttl">
              <span class="moon" />
              {t.c.title}
            </span>
            <span class="chip" dir="ltr">{t.c.ch}</span>
          </div>
          <div class="ads">
            {t.c.ads.map(([title, cta, l], i) => (
              <div class="ad" data-step={String(i + 1)} dir={l === 'ar' ? 'rtl' : 'ltr'} lang={l}>
                <span class:list={['ad-img', `ad-img--${i + 1}`]}>
                  <Fragment set:html={adArt[i]} />
                </span>
                <span class="ad-t">{title}</span>
                <span class="ad-s">{cta}</span>
              </div>
            ))}
          </div>
          <div class="kpis kpis--3">
            <div class="k k--1" data-step="4">
              <span class="kl">{t.c.k[0]}</span>
              <b data-fx="count" data-to="1.2" data-decimals="1">1.2</b>
              <i>M</i>
            </div>
            <div class="k k--2" data-step="4">
              <span class="kl">{t.c.k[1]}</span>
              <b data-fx="count" data-to="3.4" data-decimals="1">3.4</b>
              <i>%</i>
            </div>
            <div class="k k--3" data-step="4">
              <span class="kl">{t.c.k[2]}</span>
              <b data-fx="count" data-to="5.1" data-decimals="1">5.1</b>
              <i>×</i>
            </div>
          </div>
        </div>
      )
    }

    {
      scene === 'inbox' && (
        <div class="win">
          <div class="bar">
            <span class="ttl">{t.i.title}</span>
            <span class="chip chip--hot">{t.i.n}</span>
          </div>
          <ul class="msgs">
            {t.i.m.map(([av, name, text, tag, k], i) => (
              <li data-step={String(i + 1)}>
                <span class:list={['av', `av--${i + 1}`]}>{av}</span>
                <span class="txt">
                  <b>{name}</b>
                  <span>{text}</span>
                </span>
                <span class:list={['tag', `tag--${k}`]}>{tag}</span>
              </li>
            ))}
          </ul>
          <div class="draft" data-step="4">
            <span class="dl">
              <span class="spark">✦</span>
              {t.i.draft}
            </span>
            <p data-fx="type">{t.i.reply}</p>
          </div>
          <div class="actions">
            <span class="btn-s" data-step="5" data-fx="pop">{t.i.send}</span>
            <span class="ok" data-step="6" data-fx="pop">{t.i.sent}</span>
          </div>
        </div>
      )
    }

    {
      scene === 'fleet' && (
        <div class="win">
          <div class="bar">
            <span class="ttl">
              <span class="shield">
                <svg viewBox="0 0 20 20"><path d="M10 1.5 3 4.3v5c0 4.4 3 7.7 7 9.2 4-1.5 7-4.8 7-9.2v-5z" /><path d="m6.7 10 2.3 2.3 4.4-4.6" class="tick" /></svg>
              </span>
              {t.f.title}
            </span>
            <span class="chip">{t.f.n}</span>
          </div>
          <div class="kpis">
            <div class="k k--1" data-step="1">
              <span class="kl">{t.f.k[0]}</span>
              <b data-fx="count" data-to="100">100</b>
              <i>%</i>
            </div>
            <div class="k k--2" data-step="1">
              <span class="kl">{t.f.k[1]}</span>
              <b data-fx="count" data-to="38">38</b>
              <i>/40</i>
            </div>
          </div>
          <ul class="devices">
            {devices.map(([n, os, kind], i) => (
              <li data-step={String(i + 2)}>
                <span class="dev">
                  <span class="dev-ic">
                    {kind === 'laptop' ? (
                      <svg viewBox="0 0 24 18"><rect x="4" y="2" width="16" height="11" rx="1.5" /><path d="M1.5 15.5h21" /></svg>
                    ) : (
                      <svg viewBox="0 0 24 18"><rect x="6" y="1" width="12" height="16" rx="2" /><path d="M11 14.5h2" /></svg>
                    )}
                  </span>
                  <span class="dn" dir="ltr">
                    <b>{n}</b>
                    <span>{os}</span>
                  </span>
                </span>
                <span class="status" data-step={String(i + 3)} data-fx="pop">
                  ✓ {t.f.ok}
                </span>
              </li>
            ))}
          </ul>
          <div class="progress" data-step="6">
            <span class="pl">{t.f.backup}</span>
            <span class="track">
              <span class="fill" data-fx="grow-x" />
            </span>
            <span class="pv">{t.f.done}</span>
          </div>
        </div>
      )
    }

    {
      scene === 'growth' && (
        <div class="win">
          <div class="bar">
            <span class="ttl">{t.g.title}</span>
            <span class="chip">{t.g.n}</span>
          </div>
          <div class="kpis">
            <div class="k k--1" data-step="1">
              <span class="kl">{t.g.k[0]}</span>
              <b data-fx="count" data-to="44">44</b>
              <i>{t.g.wk}</i>
            </div>
            <div class="k k--2" data-step="1">
              <span class="kl">{t.g.k[1]}</span>
              <span class="num" dir="ltr">
                <b>−</b>
                <b data-fx="count" data-to="38">38</b>
                <i>%</i>
              </span>
            </div>
          </div>
          <svg class="chart" viewBox="0 0 100 42" preserveAspectRatio="none" data-step="2" data-fx="wipe" direction="ltr">
            <defs>
              <linearGradient id="g-area" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#7c3aed" stop-opacity="0.35" />
                <stop offset="1" stop-color="#7c3aed" stop-opacity="0" />
              </linearGradient>
            </defs>
            <line x1="0" y1="40" x2="100" y2="40" class="axis" />
            <line x1="0" y1="22" x2="100" y2="22" class="grid" />
            <line x1="0" y1="4" x2="100" y2="4" class="grid" />
            <polyline points={`0,40 ${pts} 100,40`} class="area" data-fx="fade" />
            <polyline points={pts} class="line" />
          </svg>
          <div class="sources" data-step="3">
            {t.g.src.map((s, i) => (
              <span class={`src src--${i + 1}`}>
                <span class="b">
                  <i data-fx="grow-x" />
                </span>
                {s}
              </span>
            ))}
          </div>
        </div>
      )
    }

    {
      scene === 'flow' && (
        <div class="win">
          <div class="bar">
            <span class="ttl">{t.l.title}</span>
            <span class="chip chip--auto">{t.l.n}</span>
          </div>
          <div class="flow">
            {t.l.nodes.map((n, i) => (
              <>
                {i > 0 && <span class="wire" data-step={String(i + 1)} data-fx="grow-x" />}
                <span class:list={['node', `node--${i + 1}`]} data-step={String(i + 1)}>
                  <span class="n-ic" />
                  {n}
                </span>
              </>
            ))}
          </div>
          <table class="rows">
            <tbody>
              {t.l.rows.map(([k, v], i) => (
                <tr data-step={i < 2 ? '4' : '5'}>
                  <td>{k}</td>
                  <td>{v}</td>
                  <td>{i < 2 ? <span class="okc">✓</span> : <span class="flag">{t.l.review}</span>}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <div class="actions">
            <span class="ok" data-step="6" data-fx="pop">{t.l.done}</span>
          </div>
        </div>
      )
    }
  </div>
</div>

<style>
