---
// Animated product scenes for the project showcases. Each is an original,
// realistic interface for a fictional business, showing what the engagement
// delivers. Everything is CSS and inline SVG: no photos, so pages stay light.
// Without JS or with reduced motion the scene shows its finished state;
// with motion on, motion.ts plays each [data-step] in order on a loop
// while the scene is in view. Text follows the page language and direction.
import type { Project } from '../data/site';
import { langOf, dirOf } from '../i18n';
import AppShell from './AppShell.astro';
import { foodDefs, heroPhoto, dishPhoto, adArt } from './scene-art';

interface Props {
  scene: Project['scene'];
  label: string;
}
const { scene, label } = Astro.props;
const lang = langOf(Astro.url);
const dir = dirOf(lang);
const ar = lang === 'ar';

const growth = [12, 14, 13, 18, 17, 22, 26, 25, 31, 35, 38, 44];
const max = 48;
const pts = growth.map((v, i) => `${(i / (growth.length - 1)) * 100},${40 - (v / max) * 36}`).join(' ');

