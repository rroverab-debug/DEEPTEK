const devices = [
  ['Finance-01', 'Windows 11 · Laptop', 'laptop'],
  ['Sales-07', 'macOS · MacBook', 'laptop'],
  ['Warehouse-03', 'Windows 11 · Desktop', 'laptop'],
  ['Reception-02', 'iPadOS · Tablet', 'tablet'],
];
const bars = [40, 55, 48, 70, 62, 88, 76];
---

<div class:list={['scene', `scene--${scene}`]} data-scene role="img" aria-label={label}>
  <span class="ex" aria-hidden="true" dir={dir} lang={lang}>{t.example}</span>
  <div class="stage" data-stage aria-hidden="true" dir={dir} lang={lang}>
    {
      scene === 'website' && (
        <div class="site-wrap">
          <Fragment set:html={foodDefs} />
          <div class="browser" data-step="1">
            <div class="b-bar" dir="ltr">
              <span class="dots"><i /><i /><i /></span>
              <span class="url">
                <svg viewBox="0 0 10 12" class="lock"><rect x="1" y="5" width="8" height="6.5" rx="1.2" /><path d="M3 5V3.6a2 2 0 0 1 4 0V5" /></svg>
                {t.w.url}
              </span>
            </div>
            <div class="b-page">
              <div class="b-nav">
                <span class="brand">
                  <svg viewBox="0 0 20 20" class="sun"><circle cx="10" cy="10" r="4.2" />{[0, 45, 90, 135, 180, 225, 270, 315].map((a) => <rect x="9.3" y="1" width="1.4" height="3.4" rx="0.7" transform={`rotate(${a} 10 10)`} />)}</svg>
                  {t.w.brand}
                </span>
                <span class="links">{t.w.links.map((l) => <span>{l}</span>)}</span>
                <span class="nav-end">
                  <span class="lang">{t.w.lang}</span>
                  <span class="nav-cta">{t.w.navCta}</span>
                </span>
              </div>
              <div class="b-hero" data-step="2" data-fx="wipe">
                <span class="photo"><Fragment set:html={heroPhoto} /></span>
                <span class="shade" />
                <div class="b-copy">
                  <span class="w-eye" data-step="3">{t.w.eyebrow}</span>
                  <span class="headline" data-step="3">{t.w.h}</span>
                  <span class="sub" data-step="3">{t.w.sub}</span>
                  <span class="ctas">
                    <span class="cta-s" data-step="4" data-fx="pop">{t.w.book}</span>
                    <span class="cta-o" data-step="4" data-fx="pop">{t.w.menu}</span>
                  </span>
                </div>
              </div>
              <div class="sec-h" data-step="5">
                <b>{t.w.secH}</b>
                <span>{t.w.secL}</span>
              </div>
              <div class="b-cards" data-step="5">
                {t.w.items.map(([n, d, p, k]) => (
                  <span class="mi">
                    <span class="mi-pic"><Fragment set:html={dishPhoto(k)} /></span>
                    <span class="mi-t">
                      <b>{n}</b>
                      <small>{d}</small>
                      <i>{p}</i>
                    </span>
                  </span>
                ))}
              </div>
            </div>
          </div>
          <div class="phone" data-step="6" data-fx="pop">
            <span class="notch" />
            <span class="p-nav">
              <b>{t.w.brand}</b>
              <span class="burger"><i /><i /><i /></span>
            </span>
            <span class="p-hero">
              <span class="photo"><Fragment set:html={heroPhoto} /></span>
              <span class="shade" />
              <span class="p-h">{t.w.phoneH}</span>
            </span>
            <span class="cta-s">{t.w.book}</span>
            <span class="p-card">
              <span class="mi-pic"><Fragment set:html={dishPhoto('rice')} /></span>
              <span class="mi-t">
                <b>{t.w.items[0][0]}</b>
                <i>{t.w.items[0][2]}</i>
              </span>
            </span>
          </div>
          <span class="score" data-step="7" data-fx="pop">
            <span class="ring" />
            <b data-fx="count" data-to="98">98</b>
            {t.w.speed}
          </span>
        </div>
      )
    }

    {
      scene === 'saas' && (
        <AppShell url="app.glowbook.example" brand="Glow" nav={t.s.nav} icons={['home', 'cal', 'users', 'card', 'gear']} search={t.s.search} me="NA" step="1">
          <div class="head">
            <span class="hd">
              <b>{t.s.hello}</b>
              <small>{t.s.sub}</small>
            </span>
            <span class="chip">{t.s.today}</span>
          </div>
          <div class="kpis kpis--3">
            <div class="k k--1" data-step="2">
              <span class="kl">{t.s.k[0]}</span>
              <b data-fx="count" data-to="128">128</b>
              <span class="delta up">{t.s.d[0]}</span>
            </div>
            <div class="k k--2" data-step="2">
              <span class="kl">{t.s.k[1]}</span>
              <i>{t.s.cur}</i>
              <b data-fx="count" data-to="9840">9,840</b>
              <span class="delta up">{t.s.d[1]}</span>
            </div>
            <div class="k k--3" data-step="2">
              <span class="kl">{t.s.k[2]}</span>
              <b data-fx="count" data-to="2">2</b>
              <span class="delta up">{t.s.d[2]}</span>
            </div>
          </div>
          <div class="panel">
            <span class="ph">{t.s.chart}</span>
            <div class="bars" data-step="3">
              {bars.map((_, i) => (
                <span class={`bar-${i}`} data-fx="grow-y" />
              ))}
            </div>
            <div class="days">{t.s.days.map((d) => <span>{d}</span>)}</div>
          </div>
          <table class="tbl">
            <thead>
              <tr>{t.s.cols.map((c) => <th>{c}</th>)}</tr>
            </thead>
            <tbody>
              {t.s.a.map(([time, av, who, what, st, tone], i) => (
                <tr data-step={String(i + 4)} class:list={{ extra: i === 2 }}>
                  <td class="time">{time}</td>
                  <td>
                    <span class="who">
                      <span class:list={['av', `av--${i + 1}`]}>{av}</span>
                      <span class="w2">
                        <b>{who}</b>
                        <small>{what}</small>
                      </span>
                    </span>
                  </td>
                  <td>
                    <span class:list={['pill', `pill--${tone}`]}>{st}</span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </AppShell>
      )
    }

    {
      scene === 'hr' && (
        <AppShell url="people.teamhub.example" brand="TeamHub" nav={t.h.nav} icons={['home', 'users', 'target', 'cal', 'doc']} active={2} search={t.h.search} me="HR" step="1">
          <div class="head">
            <span class="person">
              <span class="av av--big">{t.h.av}</span>
              <span class="hd">
                <b>{t.h.name}</b>
                <small>{t.h.role}</small>
              </span>
            </span>
            <span class="chip">{t.h.starts}</span>
          </div>
          <div class="progress" data-step="2">
            <span class="pl">{t.h.ready}</span>
            <span class="track">
              <span class="fill fill--75" data-fx="grow-x" />
            </span>
            <span class="pv">75%</span>
          </div>
          <table class="tbl checks">
            <thead>
              <tr>{t.h.cols.map((c) => <th>{c}</th>)}</tr>
            </thead>
            <tbody>
              {t.h.checks.map(([c, o], i) => (
                <tr data-step={String(i < 3 ? i + 3 : 6)} class:list={{ pending: i === 3 }}>
                  <td>
                    <span class="task">
                      {i < 3 ? <span class="box" data-step={String(i + 3)} data-fx="pop">✓</span> : <span class="box box--empty" />}
                      {c}
                    </span>
                  </td>
                  <td>
                    <span class="owner">{o}</span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
          <div class="leave" data-step="7">
            <span class="lv-ic">
              <svg viewBox="0 0 20 20"><rect x="2.5" y="4" width="15" height="13" rx="2" /><path d="M2.5 8h15M6.5 2v4M13.5 2v4" /></svg>
            </span>
            <span class="lv-t">
              <b>{t.h.leave}</b>
              <span>{t.h.who}</span>
            </span>
            <span class="btn-s" data-step="8" data-fx="pop">{t.h.ok}</span>
          </div>
        </AppShell>
      )
    }

    {
      scene === 'campaign' && (
        <AppShell url="ads.campaigndesk.example" brand="AdDesk" nav={t.c.nav} icons={['megaphone', 'doc', 'users', 'chart']} search={t.c.search} me="MK" step="1">
          <div class="head">
            <span class="hd">
              <b>{t.c.title}</b>
              <small dir="ltr">{t.c.ch}</small>
            </span>
            <span class="chip chip--live">
              <span class="dot" />
              {t.c.status}
            </span>
          </div>
          <div class="ads">
            {t.c.ads.map(([title, cta, l], i) => (
              <div class="ad" data-step={String(i + 2)}>
                <span class="ad-top">
                  <span class="ad-av" />
                  <span class="ad-who">
                    <b>{t.c.brand}</b>
                    <small>{t.c.sp}</small>
                  </span>
                </span>
                <span class="ad-img">
                  <Fragment set:html={adArt[i]} />
                </span>
                <span class="ad-foot" dir={l === 'ar' ? 'rtl' : 'ltr'} lang={l}>
                  <span class="ad-t">{title}</span>
                  <span class="ad-s">{cta}</span>
                </span>
              </div>
            ))}
          </div>
          <div class="kpis kpis--3">
            <div class="k k--1" data-step="5">
              <span class="kl">{t.c.k[0]}</span>
              <b data-fx="count" data-to="1.2" data-decimals="1">1.2</b>
              <i>M</i>
            </div>
            <div class="k k--2" data-step="5">
              <span class="kl">{t.c.k[1]}</span>
              <b data-fx="count" data-to="3.4" data-decimals="1">3.4</b>
              <i>%</i>
            </div>
            <div class="k k--3" data-step="5">
              <span class="kl">{t.c.k[2]}</span>
              <b data-fx="count" data-to="5.1" data-decimals="1">5.1</b>
              <i>×</i>
            </div>
          </div>
        </AppShell>
      )
    }

    {
      scene === 'inbox' && (
        <AppShell url="inbox.clinicdesk.example" brand="ClinicDesk" nav={t.i.nav} icons={['inbox', 'users', 'cal', 'doc', 'gear']} search={t.i.search} me="RC" step="1">
          <div class="head">
            <span class="hd">
              <b>{t.i.title}</b>
            </span>
            <span class="chip chip--hot">{t.i.n}</span>
          </div>
          <ul class="msgs">
            {t.i.m.map(([av, name, text, tag, k, ago], i) => (
              <li data-step={String(i + 2)}>
                <span class:list={['av', `av--${i + 1}`]}>{av}</span>
                <span class="txt">
                  <span class="tn">
                    <b>{name}</b>
                    <small>{ago}</small>
                  </span>
                  <span>{text}</span>
                </span>
                <span class:list={['tag', `tag--${k}`]}>{tag}</span>
              </li>
            ))}
          </ul>
          <div class="draft" data-step="5">
            <span class="dl">
              <span class="spark">✦</span>
              {t.i.draft}
            </span>
            <p data-fx="type">{t.i.reply}</p>
          </div>
          <div class="actions">
            <span class="btn-s" data-step="6" data-fx="pop">{t.i.send}</span>
            <span class="ok" data-step="7" data-fx="pop">{t.i.sent}</span>
          </div>
        </AppShell>
      )
    }

    {
      scene === 'fleet' && (
        <AppShell url="it.devicehub.example" brand="DeviceHub" nav={t.f.nav} icons={['laptop', 'users', 'shield', 'cloud', 'chart']} search={t.f.search} me="IT" step="1">
          <div class="head">
            <span class="hd">
              <b>{t.f.title}</b>
            </span>
            <span class="chip">{t.f.n}</span>
          </div>
          <div class="kpis">
            <div class="k k--1" data-step="2">
              <span class="kl">{t.f.k[0]}</span>
              <b data-fx="count" data-to="100">100</b>
              <i>%</i>
            </div>
            <div class="k k--2" data-step="2">
              <span class="kl">{t.f.k[1]}</span>
              <b data-fx="count" data-to="38">38</b>
              <i>/40</i>
            </div>
          </div>
          <table class="tbl">
            <thead>
              <tr>{t.f.cols.map((c) => <th>{c}</th>)}</tr>
            </thead>
            <tbody>
              {devices.map(([n, os, kind], i) => (
                <tr data-step={String(i + 3)}>
                  <td>
                    <span class="dev">
                      <span class="dev-ic">
                        {kind === 'laptop' ? (
                          <svg viewBox="0 0 24 18"><rect x="4" y="2" width="16" height="11" rx="1.5" /><path d="M1.5 15.5h21" /></svg>
                        ) : (
                          <svg viewBox="0 0 24 18"><rect x="6" y="1" width="12" height="16" rx="2" /><path d="M11 14.5h2" /></svg>
                        )}
                      </span>
                      <span class="dn" dir="ltr">
                        <b>{n}</b>
                        <small>{os}</small>
                      </span>
                    </span>
                  </td>
                  <td>
                    <span class="status" data-step={String(i + 4)} data-fx="pop">
                      ✓ {t.f.ok}
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
          <div class="progress" data-step="7">
            <span class="pl">{t.f.backup}</span>
            <span class="track">
              <span class="fill" data-fx="grow-x" />
            </span>
            <span class="pv">{t.f.done}</span>
          </div>
        </AppShell>
      )
    }

    {
      scene === 'growth' && (
        <AppShell url="leads.estatly.example" brand="Estatly" nav={t.g.nav} icons={['home', 'users', 'megaphone', 'search', 'chart']} search={t.g.search} me="RE" step="1">
          <div class="head">
            <span class="hd">
              <b>{t.g.title}</b>
            </span>
            <span class="chip">{t.g.n}</span>
          </div>
          <div class="kpis">
            <div class="k k--1" data-step="2">
              <span class="kl">{t.g.k[0]}</span>
              <b data-fx="count" data-to="44">44</b>
              <i>{t.g.wk}</i>
            </div>
            <div class="k k--2" data-step="2">
              <span class="kl">{t.g.k[1]}</span>
              <span class="num" dir="ltr">
                <b>−</b>
                <b data-fx="count" data-to="38">38</b>
                <i>%</i>
              </span>
            </div>
          </div>
          <div class="panel chart-panel" dir="ltr">
            <span class="ylab">
              <span>48</span>
              <span>24</span>
              <span>0</span>
            </span>
            <svg class="chart" viewBox="0 0 100 42" preserveAspectRatio="none" data-step="3" data-fx="wipe">
              <defs>
                <linearGradient id="g-area" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0" stop-color="#7c3aed" stop-opacity="0.3" />
                  <stop offset="1" stop-color="#7c3aed" stop-opacity="0" />
                </linearGradient>
              </defs>
              <line x1="0" y1="40" x2="100" y2="40" class="axis" />
              <line x1="0" y1="22" x2="100" y2="22" class="grid" />
              <line x1="0" y1="4" x2="100" y2="4" class="grid" />
              <polyline points={`0,40 ${pts} 100,40`} class="area" data-fx="fade" />
              <polyline points={pts} class="line" />
            </svg>
            <span class="xlab">{t.g.x.map((x) => <span>{x}</span>)}</span>
          </div>
          <div class="sources" data-step="4">
            <span class="ph">{t.g.srcH}</span>
            {t.g.src.map(([s, v], i) => (
              <span class={`src src--${i + 1}`}>
                <span class="sn">{s}</span>
                <span class="b">
                  <i data-fx="grow-x" />
                </span>
                <span class="sv">{v}</span>
              </span>
            ))}
          </div>
        </AppShell>
      )
    }

    {
      scene === 'flow' && (
        <AppShell url="finance.ledgerly.example" brand="Ledgerly" nav={t.l.nav} icons={['home', 'chart', 'bank', 'flow', 'gear']} active={1} search={t.l.search} me="FN" step="1">
          <div class="head">
            <span class="hd">
              <b>{t.l.title}</b>
            </span>
            <span class="chip chip--auto">{t.l.n}</span>
          </div>
          <div class="flow">
            {t.l.nodes.map((n, i) => (
              <>
                {i > 0 && <span class="wire" data-step={String(i + 2)} data-fx="grow-x" />}
                <span class:list={['node', `node--${i + 1}`]} data-step={String(i + 2)}>
                  <span class="n-ic" />
                  {n}
                </span>
              </>
            ))}
          </div>
          <table class="tbl rows">
            <thead>
              <tr>{t.l.cols.map((c) => <th>{c}</th>)}</tr>
            </thead>
            <tbody>
              {t.l.rows.map(([k, v], i) => (
                <tr data-step={i < 2 ? '5' : '6'}>
                  <td>{k}</td>
                  <td class="amt">{v}</td>
                  <td class="st">{i < 2 ? <span class="okc">✓</span> : <span class="flag">{t.l.review}</span>}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <div class="actions">
            <span class="ok" data-step="7" data-fx="pop">{t.l.done}</span>
          </div>
        </AppShell>
      )
    }
  </div>
</div>

<style>
  /* ---------- shared ---------- */
  .scene {
    --ink: #0f172a;
    --sub: #64748b;
    --line: #eef1f5;
    --soft: #f6f8fb;
    --a: #e0572a;
    --a-soft: #fde9df;
    --bg1: #fbd9c4;
    --bg2: #f3a27d;
    position: relative;
    width: 100%;
    height: 100%;
    container-type: inline-size;
    background:
      radial-gradient(90% 80% at 0% 0%, rgb(255 255 255 / 0.55), transparent 60%),
      linear-gradient(135deg, var(--bg1), var(--bg2));
    color: var(--ink);
    overflow: hidden;
    display: grid;
    place-items: center;
  }
  .scene--saas { --a: #c0398a; --a-soft: #fbe3f1; --bg1: #fce1ef; --bg2: #cdb8f4; }
  .scene--hr { --a: #0f9488; --a-soft: #dcf4f1; --bg1: #d2f3ec; --bg2: #a9d6f0; }
  .scene--campaign { --a: #3446a8; --a-soft: #e3e7fb; --bg1: #f6e7c5; --bg2: #b9c4ef; }
  .scene--inbox { --a: #16a34a; --a-soft: #dcfce7; --bg1: #d6f5e1; --bg2: #b4ddf2; }
  .scene--fleet { --a: #2f6fe4; --a-soft: #e2ecfd; --bg1: #d9e6fd; --bg2: #c9c0f6; }
  .scene--growth { --a: #7c3aed; --a-soft: #efe6fe; --bg1: #e6dcfd; --bg2: #b8cdf8; }
  .scene--flow { --a: #d97706; --a-soft: #fdf0dc; --bg1: #fdeccb; --bg2: #f4c39c; }

  .ex {
    position: absolute;
    inset-block-start: 0.85rem;
    inset-inline-start: 0.85rem;
    z-index: 2;
    padding: 0.25rem 0.65rem;
    border-radius: 99px;
    background: rgb(255 255 255 / 0.7);
    color: #334155;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.02em;
  }
  .stage {
    /* Fades in and out on a loop: keep it on its own layer so it never repaints. */
    will-change: opacity;
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    padding: clamp(2.6rem, 6cqi, 3.6rem) clamp(12px, 5cqi, 3rem) clamp(14px, 5cqi, 3rem);
    font-size: clamp(9.5px, 1.95cqi, 14px);
  }
  .head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.8em;
  }
  .hd {
    display: grid;
    min-width: 0;
  }
  .hd b {
    font-size: 1.12em;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .hd small {
    color: var(--sub);
    font-size: 0.78em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .chip {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    padding: 0.22em 0.7em;
    border-radius: 99px;
    background: var(--a-soft);
    color: var(--a);
    font-size: 0.74em;
    font-weight: 650;
    white-space: nowrap;
  }
  .chip--hot { background: #ef4444; color: #fff; }
  .chip--live { background: #dcfce7; color: #15803d; }
  .chip--auto { background: #dcfce7; color: #15803d; }
  .dot {
    width: 0.5em;
    height: 0.5em;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 0 0.2em rgb(34 197 94 / 0.25);
  }
  .panel {
    display: grid;
    gap: 0.4em;
    padding: 0.7em 0.8em;
    border: 1px solid var(--line);
    border-radius: 0.6em;
  }
  .ph {
    font-size: 0.78em;
    font-weight: 650;
    color: #334155;
  }
  .kl {
    flex-basis: 100%;
    margin-bottom: 0.25em;
    color: var(--sub);
    font-size: 0.74em;
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .kpis {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.6em;
  }
  .kpis--3 {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .k {
    --kc: var(--a);
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.15em;
    padding: 0.6em 0.75em;
    border-radius: 0.6em;
    border: 1px solid var(--line);
    background: #fff;
    box-shadow: 0 1px 2px rgb(15 23 42 / 0.05);
    min-width: 0;
  }
  .k::before {
    content: '';
    position: absolute;
    inset-block-start: 0.7em;
    inset-inline-end: 0.7em;
    width: 0.45em;
    height: 0.45em;
    border-radius: 50%;
    background: var(--kc);
  }
  .k b {
    font-size: 1.75em;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .kpis--3 .k b {
    font-size: 1.4em;
  }
  .k i {
    font-style: normal;
    color: var(--sub);
    font-size: 0.8em;
  }
  .k .num {
    display: flex;
    align-items: baseline;
    gap: 0.05em;
  }
  .delta {
    margin-inline-start: auto;
    padding: 0.05em 0.4em;
    border-radius: 0.3em;
    font-size: 0.66em;
    font-weight: 650;
  }
  .delta.up { background: #dcfce7; color: #15803d; }
  .av {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.1em;
    height: 2.1em;
    border-radius: 50%;
    color: #fff;
    font-size: 0.76em;
    font-weight: 700;
    background: var(--a);
  }
  .av--1 { background: linear-gradient(135deg, #fb923c, #e0572a); }
  .av--2 { background: linear-gradient(135deg, #60a5fa, #2f6fe4); }
  .av--3 { background: linear-gradient(135deg, #a78bfa, #7c3aed); }
  .btn-s {
    padding: 0.5em 1.05em;
    border-radius: 0.5em;
    background: var(--a);
    color: #fff;
    font-weight: 650;
    font-size: 0.82em;
    white-space: nowrap;
    box-shadow: 0 0.3em 0.8em -0.3em color-mix(in srgb, var(--a) 80%, transparent);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6em;
    align-items: center;
    justify-content: flex-end;
  }
  .ok {
    padding: 0.35em 0.8em;
    border-radius: 99px;
    background: #dcfce7;
    color: #15803d;
    font-size: 0.82em;
    font-weight: 650;
  }
  .progress {
    display: flex;
    align-items: center;
    gap: 0.8em;
    font-size: 0.82em;
  }
  .pl {
    color: var(--sub);
    font-weight: 500;
    white-space: nowrap;
  }
  .pv {
    font-weight: 650;
    color: var(--a);
  }
  .track {
    flex: 1;
    height: 0.5em;
    background: #eef1f5;
    border-radius: 99px;
    overflow: hidden;
  }
  .fill {
    display: block;
    height: 100%;
    border-radius: 99px;
    background: linear-gradient(90deg, var(--a), color-mix(in srgb, var(--a) 55%, #fff));
    transform-origin: left;
  }
  [dir='rtl'] .fill,
  [dir='rtl'] .wire {
    transform-origin: right;
  }
  [dir='rtl'] .fill {
    background: linear-gradient(270deg, var(--a), color-mix(in srgb, var(--a) 55%, #fff));
  }
  .tbl {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.86em;
    font-variant-numeric: tabular-nums;
  }
  .tbl th {
    padding: 0 0 0.45em;
    border-bottom: 1px solid var(--line);
    color: #94a3b8;
    font-size: 0.78em;
    font-weight: 600;
    text-align: start;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  [lang='ar'] .tbl th {
    text-transform: none;
    letter-spacing: 0;
  }
  .tbl th:last-child,
  .tbl td:last-child {
    text-align: end;
  }
  .tbl td {
    padding: 0.45em 0;
    border-bottom: 1px solid var(--line);
    vertical-align: middle;
  }
  .tbl tr:last-child td {
    border-bottom: 0;
  }

