---
// Animated product scenes for the project showcases. Each is a small,
// original interface sketch that shows what the engagement delivers.
// Without JS or with reduced motion the scene shows its finished state;
// with motion on, motion.ts plays each [data-step] in order on a loop
// while the scene is in view. Swap for real screenshots once available.
import type { Project } from '../data/site';

interface Props {
  scene: Project['scene'];
  label: string;
}
const { scene, label } = Astro.props;

const growth = [12, 14, 13, 18, 17, 22, 26, 25, 31, 35, 38, 44];
const max = 48;
const pts = growth.map((v, i) => `${(i / (growth.length - 1)) * 100},${40 - (v / max) * 36}`).join(' ');
---

<div class="scene" data-scene role="img" aria-label={label}>
  <div class="stage" data-stage aria-hidden="true">
    {
      scene === 'inbox' && (
        <div class="win">
          <div class="bar">
            <span>Unified inbox</span>
            <span class="mono">3 new</span>
          </div>
          <ul class="msgs">
            <li data-step="1">
              <span class="av">LK</span>
              <span class="txt">
                <b>Layla K.</b>
                <span>Do you have a slot on Thursday?</span>
              </span>
              <span class="tag">WhatsApp</span>
            </li>
            <li data-step="2">
              <span class="av">OM</span>
              <span class="txt">
                <b>Omar M.</b>
                <span>Price for a dental check-up?</span>
              </span>
              <span class="tag">Web</span>
            </li>
            <li data-step="3">
              <span class="av">RS</span>
              <span class="txt">
                <b>Rina S.</b>
                <span>Can I change my appointment?</span>
              </span>
              <span class="tag">Email</span>
            </li>
          </ul>
          <div class="draft" data-step="4">
            <span class="mono">AI draft · Layla K.</span>
            <p data-fx="type">Yes, Thursday 4:30pm is free at Al Barsha. Shall I book it for you?</p>
          </div>
          <div class="actions">
            <span class="btn-s" data-step="5" data-fx="pop">
              Approve and send
            </span>
            <span class="ok" data-step="6" data-fx="pop">
              ✓ Sent in 42s
            </span>
          </div>
        </div>
      )
    }

    {
      scene === 'fleet' && (
        <div class="win">
          <div class="bar">
            <span>Devices</span>
            <span class="mono">40 managed</span>
          </div>
          <div class="kpis">
            <div data-step="1">
              <span class="mono">MFA enabled</span>
              <b data-fx="count" data-to="100">100</b>
              <i>%</i>
            </div>
            <div data-step="1">
              <span class="mono">Patched</span>
              <b data-fx="count" data-to="38">38</b>
              <i>/40</i>
            </div>
          </div>
          <ul class="devices">
            {[
              ['Finance-01', 'Windows 11'],
              ['Sales-07', 'macOS'],
              ['Warehouse-03', 'Windows 11'],
              ['Reception-02', 'iPadOS'],
            ].map(([n, os], i) => (
              <li data-step={String(i + 2)}>
                <span class="dev">
                  <b>{n}</b>
                  <span>{os}</span>
                </span>
                <span class="status" data-step={String(i + 3)} data-fx="pop">
                  ✓ Secured
                </span>
              </li>
            ))}
          </ul>
          <div class="progress" data-step="6">
            <span class="mono">Nightly backup</span>
            <span class="track">
              <span class="fill" data-fx="grow-x" />
            </span>
            <span class="mono">Complete</span>
          </div>
        </div>
      )
    }

    {
      scene === 'growth' && (
        <div class="win">
          <div class="bar">
            <span>Enquiries</span>
            <span class="mono">Last 12 weeks</span>
          </div>
          <div class="kpis">
            <div data-step="1">
              <span class="mono">Direct enquiries</span>
              <b data-fx="count" data-to="44">44</b>
              <i>/wk</i>
            </div>
            <div data-step="1">
              <span class="mono">Cost per lead</span>
              <b>−</b>
              <b data-fx="count" data-to="38">38</b>
              <i>%</i>
            </div>
          </div>
          <svg class="chart" viewBox="0 0 100 42" preserveAspectRatio="none" data-step="2" data-fx="wipe">
            <line x1="0" y1="40" x2="100" y2="40" class="axis" />
            <line x1="0" y1="22" x2="100" y2="22" class="grid" />
            <line x1="0" y1="4" x2="100" y2="4" class="grid" />
            <polyline points={`0,40 ${pts} 100,40`} class="area" data-fx="fade" />
            <polyline points={pts} class="line" />
          </svg>
          <div class="sources" data-step="3">
            <span><span class="b"><i data-fx="grow-x" /></span>Search</span>
            <span><span class="b"><i data-fx="grow-x" /></span>Ads</span>
            <span><span class="b"><i data-fx="grow-x" /></span>Social</span>
          </div>
        </div>
      )
    }

    {
      scene === 'flow' && (
        <div class="win">
          <div class="bar">
            <span>Month-end report</span>
            <span class="mono">Automated</span>
          </div>
          <div class="flow">
            <span class="node" data-step="1">
              Bank feeds
            </span>
            <span class="wire" data-step="2" data-fx="grow-x" />
            <span class="node" data-step="2">
              Reconcile
            </span>
            <span class="wire" data-step="3" data-fx="grow-x" />
            <span class="node node--hi" data-step="3">
              Dashboard
            </span>
          </div>
          <table class="rows">
            <tbody>
              <tr data-step="4">
                <td>Revenue</td>
                <td>AED 1.42M</td>
                <td class="ok">✓</td>
              </tr>
              <tr data-step="4">
                <td>Expenses</td>
                <td>AED 0.97M</td>
                <td class="ok">✓</td>
              </tr>
              <tr data-step="5">
                <td>Unmatched</td>
                <td>3 items</td>
                <td class="flag">Review</td>
              </tr>
            </tbody>
          </table>
          <div class="actions">
            <span class="ok" data-step="6" data-fx="pop">
              ✓ Ready in 6 min, was 3 days
            </span>
          </div>
        </div>
      )
    }
  </div>
</div>

<style>
  .scene {
    --s-bg: #121212;
    --s-card: #1b1b1b;
    --s-line: #2e2e2e;
    --s-fg: #f3f3f1;
    --s-muted: #9a9a9a;
    position: relative;
    width: 100%;
    height: 100%;
    container-type: inline-size;
    background-color: var(--s-bg);
    background-image: radial-gradient(circle at 1px 1px, #2a2a2a 1px, transparent 0);
    background-size: 22px 22px;
    color: var(--s-fg);
    overflow: hidden;
    display: grid;
    place-items: center;
  }
  .stage {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    padding: clamp(14px, 6cqi, 4rem);
    font-size: clamp(10.5px, 2.2cqi, 15px);
  }
  .win {
    width: min(100%, 34em);
    display: grid;
    gap: 1em;
    padding: 1.25em;
    background: var(--s-card);
    border: 1px solid var(--s-line);
    border-radius: 0.6em;
    box-shadow: 0 2em 4em -1.5em rgb(0 0 0 / 0.7);
    line-height: 1.35;
  }
  .bar {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: 0.85em;
    border-bottom: 1px solid var(--s-line);
    font-weight: 500;
  }
  .mono {
    font-family: var(--font-mono);
    font-size: 0.78em;
    letter-spacing: 0.04em;
    color: var(--s-muted);
    text-transform: uppercase;
  }

  /* inbox */
  .msgs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5em;
  }
  .msgs li {
    display: flex;
    align-items: center;
    gap: 0.75em;
    padding: 0.6em 0.7em;
    border: 1px solid var(--s-line);
    border-radius: 0.45em;
  }
  .av {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.2em;
    height: 2.2em;
    border-radius: 50%;
    background: #2b2b2b;
    font-size: 0.8em;
    font-weight: 600;
  }
  .txt {
    display: grid;
    min-width: 0;
    flex: 1;
  }
  .txt b {
    font-weight: 500;
  }
  .txt span {
    color: var(--s-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .tag {
    flex: none;
    font-size: 0.75em;
    padding: 0.2em 0.6em;
    border: 1px solid var(--s-line);
    border-radius: 99px;
    color: var(--s-muted);
  }
  .draft {
    display: grid;
    gap: 0.4em;
    padding: 0.8em 0.9em;
    background: var(--s-fg);
    color: #111;
    border-radius: 0.45em;
  }
  .draft .mono {
    color: #555;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6em;
    align-items: center;
    justify-content: flex-end;
  }
  .btn-s {
    padding: 0.5em 1em;
    border-radius: 99px;
    background: var(--s-fg);
    color: #111;
    font-weight: 500;
    font-size: 0.9em;
  }
  .ok {
    font-size: 0.9em;
    color: var(--s-fg);
    font-weight: 500;
  }

  /* fleet and growth kpis */
  .kpis {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.6em;
  }
  .kpis div {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.1em;
    padding: 0.7em 0.8em;
    border: 1px solid var(--s-line);
    border-radius: 0.45em;
  }
  .kpis .mono {
    flex-basis: 100%;
    margin-bottom: 0.3em;
  }
  .kpis b {
    font-size: 2em;
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .kpis i {
    font-style: normal;
    color: var(--s-muted);
  }
  .devices {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }
  .devices li {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.55em 0;
    border-bottom: 1px solid var(--s-line);
  }
  .dev {
    display: flex;
    gap: 0.75em;
    align-items: baseline;
  }
  .dev b {
    font-weight: 500;
  }
  .dev span {
    color: var(--s-muted);
    font-size: 0.85em;
  }
  .status {
    font-size: 0.8em;
    padding: 0.2em 0.65em;
    border-radius: 99px;
    background: var(--s-fg);
    color: #111;
    font-weight: 500;
  }
  .progress {
    display: flex;
    align-items: center;
    gap: 0.8em;
  }
  .track {
    flex: 1;
    height: 0.35em;
    background: #2b2b2b;
    border-radius: 99px;
    overflow: hidden;
  }
  .fill {
    display: block;
    height: 100%;
    background: var(--s-fg);
    transform-origin: left;
  }

  /* growth */
  .chart {
    width: 100%;
    height: 9em;
    overflow: visible;
  }
  .chart .axis {
    stroke: #444;
    stroke-width: 0.3;
  }
  .chart .grid {
    stroke: #2a2a2a;
    stroke-width: 0.3;
    stroke-dasharray: 1 1;
  }
  .chart .line {
    fill: none;
    stroke: var(--s-fg);
    stroke-width: 0.9;
    vector-effect: non-scaling-stroke;
    stroke-width: 2px;
    stroke-linejoin: round;
  }
  .chart .area {
    fill: rgb(243 243 241 / 0.08);
    stroke: none;
  }
  .sources {
    display: grid;
    gap: 0.35em;
    font-size: 0.85em;
    color: var(--s-muted);
  }
  .sources > span {
    display: grid;
    grid-template-columns: 1fr 4em;
    align-items: center;
    gap: 0.6em;
  }
  .sources .b {
    display: block;
  }
  .sources i {
    transform-origin: left;
  }
  .sources > span:nth-child(1) i {
    width: 74%;
  }
  .sources > span:nth-child(2) i {
    width: 50%;
  }
  .sources > span:nth-child(3) i {
    width: 37%;
  }
  .sources i {
    display: block;
    flex: none;
    height: 0.45em;
    background: var(--s-fg);
    border-radius: 99px;
  }

  /* flow */
  .flow {
    display: flex;
    align-items: center;
    padding-block: 0.5em;
  }
  .node {
    flex: none;
    padding: 0.55em 0.8em;
    border: 1px solid var(--s-line);
    border-radius: 0.45em;
    font-size: 0.9em;
    white-space: nowrap;
  }
  .node--hi {
    background: var(--s-fg);
    color: #111;
    border-color: var(--s-fg);
    font-weight: 500;
  }
  .wire {
    flex: 1;
    min-width: 1em;
    height: 1px;
    background: var(--s-muted);
    transform-origin: left;
  }
  .rows {
    width: 100%;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }
  .rows td {
    padding: 0.55em 0;
    border-bottom: 1px solid var(--s-line);
  }
  .rows td:nth-child(2) {
    text-align: right;
    padding-right: 1em;
  }
  .rows td:last-child {
    text-align: right;
    width: 4.5em;
  }
  .rows .flag {
    font-size: 0.8em;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
