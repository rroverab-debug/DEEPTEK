<rect width="60" height="60" fill="#1b2550"/>
<circle cx="8" cy="10" r=".9" fill="#fde68a"/><circle cx="50" cy="44" r=".8" fill="#fde68a"/><circle cx="26" cy="7" r=".7" fill="#fde68a"/><circle cx="14" cy="40" r=".7" fill="#fde68a"/>
<circle cx="42" cy="17" r="9" fill="#f2c14e"/><circle cx="46" cy="14" r="8" fill="#1b2550"/>
<path d="M24 0v13" stroke="#f2c14e" stroke-width=".8"/>
<path d="M18 17h12l-2 3H20z" fill="#e0a83a"/>
<rect x="19" y="20" width="10" height="16" rx="2" fill="#f2c14e"/>
<rect x="21.5" y="22.5" width="5" height="11" rx="2.5" fill="#fff4c8"/>
<path d="M18 36h12l-2 3H20z" fill="#e0a83a"/>
<rect x="0" y="48" width="60" height="12" fill="#c8901f" opacity=".9"/>
<path d="M0 48q7-5 15 0t15 0 15 0 15 0" fill="#c8901f"/>
</svg>`,
  `<svg viewBox="0 0 60 60" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
<rect width="60" height="60" fill="#0f5257"/>
<path d="M10 60V30a20 20 0 0 1 40 0v30" fill="#13676c"/>
<path d="M16 60V32a14 14 0 0 1 28 0v28" fill="none" stroke="#f2c14e" stroke-width="1.4"/>
<path d="M30 14l2 4.5 4.5 2-4.5 2-2 4.5-2-4.5-4.5-2 4.5-2z" fill="#f2c14e"/>
<circle cx="30" cy="44" r="7" fill="#f7d98b"/><circle cx="32.5" cy="42" r="6" fill="#13676c"/>
<circle cx="6" cy="8" r="1" fill="#f2c14e"/><circle cx="54" cy="10" r="1" fill="#f2c14e"/>
</svg>`,
  `<svg viewBox="0 0 60 60" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
<rect width="60" height="60" fill="#f6dcc9"/>
<circle cx="48" cy="12" r="14" fill="#f9e7d9"/>
<rect x="15" y="27" width="30" height="22" rx="2" fill="#c2185b"/>
<rect x="13" y="21" width="34" height="8" rx="2" fill="#d63a76"/>
<rect x="27" y="21" width="6" height="28" fill="#f2c14e"/>
