---
// One article in a list: category, title, summary and reading details.
import { categories, formatDate, postPath, readingMinutes, readLabel, type Post } from '../lib/blog';
import { langOf } from '../i18n';

interface Props {
  post: Post;
  index?: number;
  /** Larger layout for the newest article at the top of the blog. */
  featured?: boolean;
  /** Heading level, so cards sit correctly under the section heading. */
  level?: 'h2' | 'h3';
}
const { post, index, featured = false, level = 'h3' } = Astro.props;
const lang = langOf(Astro.url);
const Heading = level;
const minutes = readingMinutes(post);
const read = readLabel(minutes, lang);
const more = lang === 'ar' ? 'اقرأ المقال' : 'Read article';
---

<article class:list={['card', { featured }]} data-category={post.data.category}>
  <a class="hit" href={postPath(post)}>
    <div class="top">
      {index !== undefined && <span class="mono num">{String(index + 1).padStart(2, '0')}</span>}
      <span class="mono cat">{categories[post.data.category][lang]}</span>
    </div>
    <div class="body">
      <Heading class="title">{post.data.title}</Heading>
      <p class="desc">{post.data.description}</p>
    </div>
    <div class="foot">
      <span class="mono meta">
        <time datetime={post.data.date.toISOString().slice(0, 10)}>{formatDate(post.data.date, lang)}</time>
        <span aria-hidden="true"> · </span>{read}
      </span>
      <span class="more" aria-hidden="true">{more} <span class="arrow">→</span></span>
    </div>
  </a>
</article>

<style>
  .card {
    border-top: 1px solid var(--line);
  }
  .hit {
    display: grid;
    gap: 1.5rem;
    height: 100%;
    padding-block: 2rem;
    color: inherit;
    text-decoration: none;
  }
  .top {
    display: flex;
    gap: 1rem;
    align-items: baseline;
  }
  .mono {
    font-size: var(--fs-xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .num {
    color: var(--ink);
  }
  .title {
    font-size: var(--fs-xl);
    line-height: 1.12;
    letter-spacing: -0.025em;
    max-width: 24ch;
    text-wrap: balance;
  }
  .desc {
    margin-top: 0.85rem;
    color: var(--muted);
    max-width: 52ch;
  }
  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    align-self: end;
  }
  .more {
    font-weight: 500;
    font-size: var(--fs-sm);
    border-bottom: 1px solid currentColor;
  }
  .arrow {
    display: inline-block;
    transition: transform 0.3s var(--ease);
  }
  .hit:hover .title,
  .hit:focus-visible .title {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.15em;
  }
  .hit:hover .arrow {
    transform: translateX(3px);
  }
  :global([dir='rtl']) .arrow {
    transform: scaleX(-1);
  }
  :global([dir='rtl']) .hit:hover .arrow {
    transform: scaleX(-1) translateX(3px);
  }

  .featured .hit {
    padding-block: 2.5rem;
  }
  @media (min-width: 56rem) {
    .featured .hit {
      grid-template-columns: 1fr 2fr;
      grid-template-rows: auto auto;
      column-gap: 3rem;
    }
    .featured .top {
      grid-row: 1 / 3;
      align-self: start;
    }
    .featured .foot {
      grid-column: 2;
    }
  }
  .featured .title {
    font-size: var(--fs-2xl);
    letter-spacing: -0.035em;
    line-height: 1.02;
  }
  .featured .desc {
    font-size: var(--fs-lg);
  }
  :global(:lang(ar)) .title {
    line-height: 1.4;
  }
</style>
