---
import Logo from './Logo.astro';
import { content, langOf, localize, switchPath } from '../i18n';

interface Props {
  darkTop?: boolean;
}
const { darkTop = false } = Astro.props;
const lang = langOf(Astro.url);
const { nav, site } = content(lang);
const l = (href: string) => localize(href, lang);
const path = Astro.url.pathname.replace(/\/?$/, '/');
const isCurrent = (href: string) => path === l(href) || (href !== '/' && path.startsWith(l(href)));
const other = lang === 'ar' ? 'en' : 'ar';
const switchHref = switchPath(Astro.url.pathname, other);
const switchLabel = other === 'ar' ? 'العربية' : 'English';
const t = {
  en: { home: 'Home', homeLabel: `${site.name} home`, cta: 'Start a project', menu: 'Menu', close: 'Close', main: 'Main', mobile: 'Mobile', switchTo: 'View this page in Arabic' },
  ar: { home: 'الرئيسية', homeLabel: `${site.name}، الصفحة الرئيسية`, cta: 'ابدأ مشروعك', menu: 'القائمة', close: 'إغلاق', main: 'الرئيسية', mobile: 'قائمة الجوال', switchTo: 'View this page in English' },
}[lang];
---

<header class="site-header" data-header data-dark-top={darkTop ? 'true' : undefined}>
  <div class="container bar">
    <a class="brand" href={l('/')} aria-label={t.homeLabel}>
      <Logo />
    </a>

    <nav class="desktop-nav" aria-label={t.main}>
      <ul role="list">
        <li>
          <a href={l('/')} aria-current={path === l('/') ? 'page' : undefined}>{t.home}</a>
        </li>
        {
          nav.map((item) => (
            <li>
              <a href={l(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="end">
    <a class="lang-switch" href={switchHref} hreflang={other} lang={other} aria-label={t.switchTo}>{switchLabel}</a>

    <a class="header-cta" href={l('/contact/')}>{t.cta}</a>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-toggle
      data-label-open={t.menu}
      data-label-close={t.close}
    >
      <span class="menu-label">{t.menu}</span>
      <span class="menu-icon" aria-hidden="true"><span></span><span></span></span>
    </button>
    </div>
  </div>

  <div class="mobile-menu theme-night" id="mobile-menu" data-menu hidden>
    <nav class="container" aria-label={t.mobile}>
      <ul role="list">
        <li><a href={l('/')} aria-current={path === l('/') ? 'page' : undefined}><span class="mono">00</span>{t.home}</a></li>
        {
          nav.map((item, i) => (
            <li>
              <a href={l(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                <span class="mono">{String(i + 1).padStart(2, '0')}</span>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <p class="mobile-meta">
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <a href={`tel:${site.phone.tel}`}><bdi dir="ltr">{site.phone.display}</bdi></a>
        <span>{site.location}</span>
        <a href={switchHref} hreflang={other} lang={other}>{switchLabel}</a>
      </p>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');

  if (header) {
    const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 24);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  if (header && toggle && menu) {
    const label = toggle.querySelector('.menu-label');
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      if (label) label.textContent = (open ? toggle.dataset.labelClose : toggle.dataset.labelOpen) ?? '';
      menu.hidden = !open;
      header.classList.toggle('menu-open', open);
      document.body.style.overflow = open ? 'hidden' : '';
      if (open) menu.querySelector<HTMLAnchorElement>('a')?.focus();
    };

    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });

    // Keep keyboard focus inside the open menu.
    menu.addEventListener('keydown', (e) => {
      if (e.key !== 'Tab') return;
      const items = [toggle, ...menu.querySelectorAll<HTMLElement>('a')];
      const first = items[0];
      const last = items[items.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    });
    toggle.addEventListener('keydown', (e) => {
      if (e.key === 'Tab' && e.shiftKey && toggle.getAttribute('aria-expanded') === 'true') {
        e.preventDefault();
        const links = menu.querySelectorAll<HTMLElement>('a');
        links[links.length - 1]?.focus();
      }
    });

    window.matchMedia('(min-width: 64rem)').addEventListener('change', (e) => {
      if (e.matches) setOpen(false);
    });
  }
</script>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    color: var(--ink);
    transition:
      background-color 0.4s var(--ease),
      color 0.4s var(--ease),
      border-color 0.4s var(--ease);
    border-bottom: 1px solid transparent;
  }
  .site-header[data-dark-top]:not(.is-scrolled) {
    color: var(--paper);
    --focus: var(--paper);
  }
  .site-header.is-scrolled {
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: saturate(140%) blur(12px);
    -webkit-backdrop-filter: saturate(140%) blur(12px);
    border-bottom-color: var(--line);
  }
  @media (max-width: 63.99rem), (hover: none) {
    /* Phones and tablets: a background blur behind a fixed or sticky bar is
       repainted on every scroll frame and makes scrolling stutter. Use a
       solid background there instead. */
    .site-header.is-scrolled {
      background: var(--paper);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
  }
  .site-header.menu-open {
    background: var(--night);
    color: var(--paper);
    border-bottom-color: var(--night-line);
    --focus: var(--paper);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: var(--header-h);
  }

  .brand {
    display: inline-flex;
    text-decoration: none;
  }

  .desktop-nav ul {
    display: flex;
    gap: clamp(1.25rem, 2.5vw, 2.5rem);
  }
  .desktop-nav a,
  .header-cta {
    position: relative;
    font-size: var(--fs-sm);
    font-weight: 500;
    text-decoration: none;
    padding-block: 0.5rem;
  }
  .desktop-nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.2rem;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.4s var(--ease);
  }
  .desktop-nav a:hover::after,
  .desktop-nav a[aria-current='page']::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .end {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2vw, 1.75rem);
  }
  .lang-switch {
    font-size: var(--fs-sm);
    font-weight: 500;
    text-decoration: none;
    padding-block: 0.5rem;
    opacity: 0.8;
    transition: opacity 0.3s var(--ease);
  }
  .lang-switch:hover {
    opacity: 1;
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }
  :global([dir='rtl']) .desktop-nav a::after {
    transform-origin: left;
  }
  :global([dir='rtl']) .desktop-nav a:hover::after,
  :global([dir='rtl']) .desktop-nav a[aria-current='page']::after {
    transform-origin: right;
  }

  .header-cta {
    border: 1px solid currentColor;
    border-radius: 999px;
    padding: 0.55rem 1.1rem;
    transition:
      background-color 0.3s var(--ease),
      color 0.3s var(--ease);
  }
  .header-cta:hover {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }
  .site-header[data-dark-top]:not(.is-scrolled) .header-cta:hover {
    background: var(--paper);
    color: var(--ink);
    border-color: var(--paper);
  }

  .menu-toggle {
    display: none;
    align-items: center;
    gap: 0.75rem;
    min-height: 2.75rem;
    padding: 0.5rem 0;
    background: none;
    border: 0;
    font-size: var(--fs-sm);
    font-weight: 500;
    cursor: pointer;
  }
  .menu-icon {
    display: grid;
    gap: 5px;
    width: 22px;
  }
  .menu-icon span {
    display: block;
    height: 1.5px;
    background: currentColor;
    transition: transform 0.35s var(--ease);
  }
  .menu-toggle[aria-expanded='true'] .menu-icon span:first-child {
    transform: translateY(3.25px) rotate(45deg);
  }
  .menu-toggle[aria-expanded='true'] .menu-icon span:last-child {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  .mobile-menu {
    position: fixed;
    inset: var(--header-h) 0 0;
    overflow-y: auto;
    padding-block: 2rem 3rem;
  }
  .mobile-menu ul a {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--night-line);
    font-size: clamp(2rem, 9vw, 3rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.1;
    text-decoration: none;
  }
  .mobile-menu ul a .mono {
    color: var(--night-muted);
  }
  .mobile-menu ul a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }
  .mobile-meta {
    display: grid;
    gap: 0.5rem;
    margin-top: 2.5rem;
    color: var(--night-muted);
    font-size: var(--fs-sm);
  }

  /* Small screens: with JS use the menu button, without JS show links inline. */
  @media (max-width: 63.99rem) {
    .header-cta {
      display: none;
    }
    :global(.js) .desktop-nav {
      display: none;
    }
    :global(.js) .menu-toggle {
      display: inline-flex;
    }
    :global(html:not(.js)) .desktop-nav ul {
      gap: 1rem;
    }
  }
  @media (max-width: 30rem) {
    :global(html:not(.js)) .bar {
      height: auto;
      flex-wrap: wrap;
      padding-block: 0.75rem;
    }
  }
</style>
