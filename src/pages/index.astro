---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ServiceRail from '../components/ServiceRail.astro';
import StickyStory from '../components/StickyStory.astro';
import ProjectShowcase from '../components/ProjectShowcase.astro';
import CallToAction from '../components/CallToAction.astro';
import { content, langOf, localize } from '../i18n';

const lang = langOf(Astro.url);
const { process, projects, values } = content(lang);
const l = (href: string) => localize(href, lang);

const t = {
  en: {
    whyLabel: 'Why DeepTek',
    why: 'Most growing businesses juggle an IT contractor, a marketing agency and a stack of tools that do not talk to each other. We bring technology, marketing and automation together, so every part of your business pulls in the same direction.',
    storyLabel: 'How we work',
    storyHeading: 'A clear process from first call to lasting results.',
    workLabel: 'Example projects',
    workHeading: 'The kind of problems we solve.',
    allWork: 'Explore our projects',
    moreText: 'Also see our SaaS products, digital marketing campaigns and IT projects.',
    moreButton: 'Explore all projects',
    valuesLabel: 'Principles',
    valuesHeading: 'What you can expect from us.',
    homeWork: [
      { label: 'AI automation', more: 'More automations' },
      { label: 'HR and operations', more: 'More operations tools' },
      { label: 'Websites', more: 'More websites' },
    ],
  },
  ar: {
    whyLabel: 'لماذا DeepTek',
    why: 'تتعامل معظم الشركات النامية مع مزوّد تقنية، ووكالة تسويق، ومجموعة أدوات لا تتواصل مع بعضها. نحن نجمع التقنية والتسويق والأتمتة معاً، ليعمل كل جزء من أعمالك في الاتجاه نفسه.',
    storyLabel: 'طريقة عملنا',
    storyHeading: 'خطوات واضحة من أول مكالمة حتى نتائج تدوم.',
    workLabel: 'نماذج من مشاريعنا',
    workHeading: 'نوع المشكلات التي نحلها.',
    allWork: 'استكشف مشاريعنا',
    moreText: 'اطلع أيضاً على منتجات SaaS وحملات التسويق الرقمي ومشاريع تقنية المعلومات.',
    moreButton: 'استكشف كل المشاريع',
    valuesLabel: 'مبادئنا',
    valuesHeading: 'ما يمكنك أن تتوقعه منا.',
    homeWork: [
      { label: 'الأتمتة بالذكاء الاصطناعي', more: 'المزيد من الأتمتة' },
      { label: 'الموارد البشرية والعمليات', more: 'المزيد من أدوات العمليات' },
      { label: 'المواقع الإلكترونية', more: 'المزيد من المواقع' },
    ],
  },
}[lang];

// Three work sections shown on the home page; everything else is on /work/.
const homeWork = [
  { ...t.homeWork[0], slug: 'clinic-automation', href: l('/work/#ai-it') },
  { ...t.homeWork[1], slug: 'hr-onboarding', href: l('/work/#hr-operations') },
  { ...t.homeWork[2], slug: 'hospitality-website', href: l('/work/#websites') },
]
  .map((w) => ({ ...w, project: projects.find((p) => p.slug === w.slug) }))
  .filter((w) => w.project);
---

<Base darkTop>
  <Hero />

  <section class="statement section" aria-labelledby="statement-label">
    <div class="container grid">
      <p class="eyebrow" id="statement-label">{t.whyLabel}</p>
      <p class="big" data-scrub-text>{t.why}</p>
    </div>
  </section>

  <ServiceRail />

  <StickyStory
    night
    label={t.storyLabel}
    heading={t.storyHeading}
    steps={process}
  />

  <section class="section" aria-labelledby="work-title">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{t.workLabel}</p>
        <div class="work-head">
          <h2 id="work-title" data-split>{t.workHeading}</h2>
          <a class="link-arrow" href={l('/work/')} data-reveal>{t.allWork} <span class="arrow" aria-hidden="true">→</span></a>
        </div>
      </div>
      <div class="showcases">
        {
          homeWork.map((w, i) => (
            <div class="home-work">
              <div class="hw-head" data-reveal>
                <span class="mono">{String(i + 1).padStart(2, '0')}</span>
                <h3>{w.label}</h3>
                <a class="link-arrow" href={w.href}>
                  {w.more} <span class="arrow" aria-hidden="true">→</span>
                </a>
              </div>
              <ProjectShowcase project={w.project!} index={i} />
            </div>
          ))
        }
      </div>
      <div class="more-work" data-reveal>
        <p>{t.moreText}</p>
        <a class="btn" href={l('/work/')}>{t.moreButton} <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="section values" aria-labelledby="values-title">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{t.valuesLabel}</p>
        <h2 id="values-title" data-split>{t.valuesHeading}</h2>
      </div>
      <ol class="value-grid" role="list" data-reveal-stagger>
        {
          values.map((v, i) => (
            <li>
              <span class="mono">{String(i + 1).padStart(2, '0')}</span>
              <h3>{v.title}</h3>
              <p>{v.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <CallToAction />
</Base>

<style>
  .grid {
    display: grid;
    gap: 2rem;
  }
  @media (min-width: 56rem) {
    .grid {
      grid-template-columns: 1fr 3fr;
    }
  }
  .big {
    font-size: var(--fs-xl);
    line-height: 1.25;
    letter-spacing: -0.025em;
    font-weight: 450;
    max-width: 32ch;
  }

  .work-head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .work-head h2 {
    font-size: var(--fs-2xl);
    max-width: 14ch;
  }
  .showcases {
    display: grid;
    gap: clamp(4rem, 10vw, 8rem);
  }
  .home-work {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }
  .hw-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }
  .hw-head .mono {
    color: var(--muted);
  }
  .hw-head h3 {
    font-size: var(--fs-lg);
    letter-spacing: -0.02em;
    margin-inline-end: auto;
  }
  .hw-head .link-arrow {
    font-size: var(--fs-sm);
  }
  .more-work {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: clamp(4rem, 8vw, 7rem);
    padding: clamp(1.5rem, 3vw, 2.5rem);
    background: var(--paper-2);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .more-work p {
    font-size: var(--fs-lg);
    max-width: 36ch;
  }

  .values {
    border-top: 1px solid var(--line);
  }
  .value-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    border-top: 1px solid var(--line);
  }
  .value-grid li {
    display: grid;
    align-content: start;
    gap: 1rem;
    padding-block: 2rem 2.5rem;
    padding-inline-end: 1.5rem;
    border-bottom: 1px solid var(--line);
  }
  .value-grid .mono {
    color: var(--muted);
    margin-bottom: 2rem;
  }
  .value-grid h3 {
    font-size: var(--fs-lg);
    letter-spacing: -0.02em;
  }
  .value-grid p {
    color: var(--muted);
    font-size: var(--fs-sm);
    max-width: 32ch;
  }
</style>
