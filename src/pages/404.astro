---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="The page you are looking for does not exist." noindex>
  <section class="nf">
    <div class="container inner">
      <p class="eyebrow">Error 404</p>
      <h1>This page does not exist.</h1>
      <p class="lead">It may have moved, or the link may be mistyped.</p>
      <div class="actions">
        <a class="btn" href="/">Go to home <span class="arrow" aria-hidden="true">→</span></a>
        <a class="btn btn--ghost" href="/contact/">Contact us</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf {
    min-height: 80vh;
    display: flex;
    align-items: center;
    padding-block: calc(var(--header-h) + 4rem) 6rem;
  }
  .inner {
    display: grid;
    gap: 2rem;
  }
  h1 {
    font-size: var(--fs-3xl);
    letter-spacing: -0.045em;
    max-width: 12ch;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
