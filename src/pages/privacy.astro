---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { content, langOf } from '../i18n';

const lang = langOf(Astro.url);
const { site } = content(lang);
const mail = `<a href="mailto:${site.email}">${site.email}</a>`;
const tel = `<a href="tel:${site.phone.tel}" dir="ltr">${site.phone.display}</a>`;

// Each section is a heading and one paragraph. Paragraphs are trusted copy from this file.
const t = {
  en: {
    title: 'Privacy notice',
    description: 'How DeepTek handles personal data submitted through this website.',
    label: 'Legal',
    heading: 'Privacy notice.',
    lead: 'Last updated: October 2026.',
    sections: [
      ['Who we are', `This website is operated by ${site.legalName} ("DeepTek", "we"), based in the United Arab Emirates. We are responsible for the personal data described in this notice.`],
      ['What we collect', 'When you use the contact form we receive the details you enter: your name, email address, and optionally your company, phone number, budget range and message. If you message us on WhatsApp, we receive your phone number, profile name and the messages you send.'],
      ['Cookies and analytics', 'We do not use advertising cookies or cross-site tracking. We may use Vercel Web Analytics or Cloudflare Web Analytics, depending on where the site is hosted, to count visits. Neither sets cookies, does not use your IP address to identify you and only produces anonymous totals such as page views and country.'],
      ['How we use it', 'We use your details only to reply to your enquiry and, if you become a client, to deliver our services and meet our legal obligations. We do not sell your details or share them for marketing.'],
      ['Services we rely on', 'The website is hosted by a cloud hosting provider (Vercel or Cloudflare), which processes technical data such as your IP address to deliver pages. Cloudflare Turnstile may be used to protect the contact form from spam. Form submissions reach us by email through a transactional email provider. WhatsApp is provided by Meta, and conversations there are also covered by WhatsApp’s own privacy policy. Some of these providers may process data outside the UAE, with appropriate safeguards.'],
      ['How long we keep it', 'Enquiries are kept for up to 24 months unless we start working together. Client records are kept for as long as UAE law requires.'],
      ['Your rights', `Under the UAE Personal Data Protection Law (Federal Decree-Law No. 45 of 2021) you can ask to access, correct or delete your personal data, or object to how we use it. Email ${mail} or call ${tel} and we will respond promptly.`],
    ],
  },
  ar: {
    title: 'إشعار الخصوصية',
    description: 'كيف تتعامل DeepTek مع البيانات الشخصية المرسلة عبر هذا الموقع.',
    label: 'قانوني',
    heading: 'إشعار الخصوصية.',
    lead: 'آخر تحديث: أكتوبر 2026.',
    sections: [
      ['من نحن', `يدير هذا الموقع <span lang="en" dir="ltr">${site.legalName}</span> ("DeepTek" أو "نحن")، ومقرها الإمارات العربية المتحدة. نحن مسؤولون عن البيانات الشخصية الموضحة في هذا الإشعار.`],
      ['ما نجمعه', 'عند استخدامك نموذج التواصل نتلقى البيانات التي تُدخلها: اسمك وبريدك الإلكتروني، واختيارياً شركتك ورقم هاتفك ونطاق الميزانية ورسالتك. وإذا راسلتنا على واتساب، نتلقى رقم هاتفك واسم ملفك الشخصي والرسائل التي ترسلها.'],
      ['ملفات تعريف الارتباط والتحليلات', 'لا نستخدم ملفات تعريف ارتباط إعلانية أو تتبعاً عبر المواقع. قد نستخدم Vercel Web Analytics أو Cloudflare Web Analytics، بحسب مكان استضافة الموقع، لعدّ الزيارات، وكلاهما لا يضع ملفات تعريف ارتباط ولا تستخدم عنوان IP الخاص بك للتعرف عليك، وتقدم فقط أرقاماً إجمالية مجهولة مثل عدد مشاهدات الصفحات والدولة.'],
      ['كيف نستخدمها', 'نستخدم بياناتك فقط للرد على استفسارك، وإذا أصبحت عميلاً، لتقديم خدماتنا والوفاء بالتزاماتنا القانونية. لا نبيع بياناتك ولا نشاركها لأغراض تسويقية.'],
      ['الخدمات التي نعتمد عليها', 'يستضيف الموقع مزود استضافة سحابية (Vercel أو Cloudflare)، ويعالج بيانات تقنية مثل عنوان IP لعرض الصفحات. وقد نستخدم Cloudflare Turnstile لحماية نموذج التواصل من البريد المزعج. تصلنا رسائل النموذج عبر البريد الإلكتروني من خلال مزود بريد للمعاملات. تقدم Meta خدمة واتساب، وتخضع المحادثات هناك أيضاً لسياسة الخصوصية الخاصة بواتساب. قد يعالج بعض هؤلاء المزودين البيانات خارج الإمارات مع ضمانات مناسبة.'],
      ['مدة الاحتفاظ', 'نحتفظ بالاستفسارات لمدة تصل إلى 24 شهراً ما لم نبدأ العمل معاً. ونحتفظ بسجلات العملاء للمدة التي يتطلبها قانون دولة الإمارات.'],
      ['حقوقك', `بموجب قانون حماية البيانات الشخصية في الإمارات (المرسوم بقانون اتحادي رقم 45 لسنة 2021) يمكنك طلب الاطلاع على بياناتك الشخصية أو تصحيحها أو حذفها، أو الاعتراض على طريقة استخدامنا لها. راسلنا على ${mail} أو اتصل على ${tel} وسنرد عليك سريعاً.`],
    ],
  },
}[lang];
---

<Base title={t.title} description={t.description}>
  <PageHero label={t.label} title={t.heading} lead={t.lead} />

  <section class="section">
    <div class="container prose">
      {
        t.sections.map(([h, body]) => (
          <>
            <h2>{h}</h2>
            <p set:html={body} />
          </>
        ))
      }
    </div>
  </section>
</Base>

<style>
  .prose {
    max-width: 46rem;
    display: grid;
    gap: 1rem;
  }
  .prose h2 {
    font-size: var(--fs-xl);
    margin-top: 2rem;
  }
  .prose h2:first-child {
    margin-top: 0;
  }
  .prose p {
    color: var(--muted);
    font-size: var(--fs-lg);
    line-height: 1.6;
  }
</style>
