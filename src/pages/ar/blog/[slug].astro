---
// Arabic articles: files in src/content/blog/ar/ with the same names as the English ones.
import BlogPost from '../../../components/BlogPost.astro';
import { getPosts, slugOf, type Post } from '../../../lib/blog';

export async function getStaticPaths() {
  const posts = await getPosts('ar');
  return posts.map((post) => ({ params: { slug: slugOf(post) }, props: { post } }));
}
const { post } = Astro.props as { post: Post };
---

<BlogPost post={post} />
