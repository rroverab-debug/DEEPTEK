---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import StickyStory from '../components/StickyStory.astro';
import CallToAction from '../components/CallToAction.astro';
import { content, langOf } from '../i18n';

const lang = langOf(Astro.url);
const { values } = content(lang);

const t = {
  en: {
    title: 'About',
    seoTitle: 'About DeepTek | Technology Partner for UAE & GCC Businesses',
    description:
      'DeepTek is a UAE-based technology company bringing IT solutions, digital marketing and AI automation together under one accountable team, for businesses across the GCC.',
    label: 'About',
    heading: 'A technology partner built for the Gulf.',
    lead: 'DeepTek is built on a simple idea: growing businesses deserve technology, marketing and automation that work together and are explained in plain language.',
    missionLabel: 'Our mission',
    mission:
      'To give every ambitious business across the GCC access to the kind of technology, marketing and automation that used to be reserved for large enterprises, delivered honestly, securely and at a fair price.',
    storyLabel: 'Our story',
    storyHeading: 'Why we started DeepTek.',
    valuesLabel: 'Values',
    valuesHeading: 'How we work with every client.',
    glance: 'At a glance',
    facts: [
      ['Based in', 'United Arab Emirates'],
      ['Disciplines', 'IT · Marketing · AI'],
      ['Languages', 'English · Arabic'],
      ['Serving', 'UAE and the wider GCC'],
      ['Working with', 'Startups to established SMEs'],
    ],
    cta: 'Let’s talk about your goals.',
    story: [
      {
        step: '01',
        title: 'Built for how Gulf businesses grow',
        body: 'Companies here move fast. New licences, new branches and new markets arrive quickly, and technology often lags behind. DeepTek exists to close that gap.',
      },
      {
        step: '02',
        title: 'One team instead of three',
        body: 'IT, marketing and automation are usually bought from different suppliers who never speak. We combine them, so your website, data and campaigns work as one system.',
      },
      {
        step: '03',
        title: 'Practical about AI',
        body: 'We use AI where it saves real time or improves service, and we say so when a simpler tool will do. Every automation is tested and kept under human control.',
      },
      {
        step: '04',
        title: 'In it for the long term',
        body: 'We want to be the partner you call for years, so we price fairly, document everything and earn the next project with the last one.',
      },
    ],
  },
  ar: {
    title: 'من نحن',
    seoTitle: 'من نحن | DeepTek شريك تقني للشركات في الإمارات والخليج',
    description:
      'DeepTek شركة تقنية مقرها الإمارات تجمع حلول تقنية المعلومات والتسويق الرقمي والأتمتة بالذكاء الاصطناعي مع فريق واحد مسؤول، للشركات في أنحاء الخليج.',
    label: 'من نحن',
    heading: 'شريك تقني صُمم لدول الخليج.',
    lead: 'تقوم DeepTek على فكرة بسيطة: الشركات النامية تستحق تقنية وتسويقاً وأتمتة تعمل معاً وتُشرح بلغة واضحة.',
    missionLabel: 'رسالتنا',
    mission:
      'أن نمنح كل شركة طموحة في دول الخليج التقنية والتسويق والأتمتة التي كانت حكراً على الشركات الكبرى، بأمانة وأمان وبسعر عادل.',
    storyLabel: 'قصتنا',
    storyHeading: 'لماذا أسسنا DeepTek.',
    valuesLabel: 'قيمنا',
    valuesHeading: 'كيف نعمل مع كل عميل.',
    glance: 'لمحة سريعة',
    facts: [
      ['المقر', 'الإمارات العربية المتحدة'],
      ['التخصصات', 'تقنية المعلومات · التسويق · الذكاء الاصطناعي'],
      ['اللغات', 'العربية · الإنجليزية'],
      ['نخدم', 'الإمارات ودول الخليج'],
      ['نعمل مع', 'من الشركات الناشئة إلى الشركات الصغيرة والمتوسطة الراسخة'],
    ],
    cta: 'لنتحدث عن أهدافك.',
    story: [
      {
        step: '01',
        title: 'مصممة لطريقة نمو الشركات في الخليج',
        body: 'الشركات هنا تتحرك بسرعة. رخص جديدة وفروع جديدة وأسواق جديدة تأتي بسرعة، وكثيراً ما تتأخر التقنية عنها. وُجدت DeepTek لسد هذه الفجوة.',
      },
      {
        step: '02',
        title: 'فريق واحد بدلاً من ثلاثة',
        body: 'عادةً ما تُشترى التقنية والتسويق والأتمتة من موردين مختلفين لا يتواصلون. نحن نجمعها، ليعمل موقعك وبياناتك وحملاتك كنظام واحد.',
      },
      {
        step: '03',
        title: 'واقعيون في الذكاء الاصطناعي',
        body: 'نستخدم الذكاء الاصطناعي حيث يوفر وقتاً حقيقياً أو يحسّن الخدمة، ونقول ذلك بصراحة عندما تكفي أداة أبسط. كل أتمتة تُختبر وتبقى تحت إشراف بشري.',
      },
      {
        step: '04',
        title: 'شراكة طويلة الأمد',
        body: 'نريد أن نكون الشريك الذي تتصل به لسنوات، لذلك نسعّر بعدل ونوثّق كل شيء ونكسب المشروع التالي بجودة المشروع الحالي.',
      },
    ],
  },
}[lang];
const story = t.story;
---

<Base title={t.title} seoTitle={t.seoTitle} description={t.description}>
  <PageHero
    label={t.label}
    title={t.heading}
    lead={t.lead}
  />

  <section class="section intro" aria-labelledby="mission-title">
    <div class="container grid">
      <h2 id="mission-title" class="eyebrow">{t.missionLabel}</h2>
      <p class="big" data-scrub-text>{t.mission}</p>
    </div>
  </section>

  <StickyStory night label={t.storyLabel} heading={t.storyHeading} steps={story} />

  <section class="section" aria-labelledby="values-title">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{t.valuesLabel}</p>
        <h2 id="values-title" data-split>{t.valuesHeading}</h2>
      </div>
      <dl class="values" data-reveal-stagger>
        {
          values.map((v) => (
            <div>
              <dt>{v.title}</dt>
              <dd>{v.body}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="section facts theme-night" aria-labelledby="facts-title">
    <div class="container">
      <h2 id="facts-title" class="sr-only">{t.glance}</h2>
      <dl class="fact-grid" data-reveal-stagger>
        {t.facts.map(([k, v]) => <div><dt class="mono">{k}</dt><dd>{v}</dd></div>)}
      </dl>
    </div>
  </section>

  <CallToAction heading={t.cta} />
</Base>

<style>
  .grid {
    display: grid;
    gap: 2rem;
  }
  @media (min-width: 56rem) {
    .grid {
      grid-template-columns: 1fr 3fr;
    }
  }
  .grid h2.eyebrow {
    font-weight: 450;
    letter-spacing: 0.08em;
    line-height: 1.6;
  }
  .big {
    font-size: var(--fs-xl);
    line-height: 1.25;
    letter-spacing: -0.025em;
    font-weight: 450;
    max-width: 32ch;
  }
  .values {
    border-top: 1px solid var(--line);
  }
  .values div {
    display: grid;
    gap: 0.75rem;
    padding-block: 2rem;
    border-bottom: 1px solid var(--line);
  }
  @media (min-width: 56rem) {
    .values div {
      grid-template-columns: 1fr 3fr;
      gap: 2rem;
    }
  }
  .values dt {
    font-size: var(--fs-xl);
    font-weight: 500;
    letter-spacing: -0.03em;
  }
  .values dd {
    color: var(--muted);
    font-size: var(--fs-lg);
    max-width: 44ch;
  }
  .fact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 2.5rem 2rem;
  }
  .fact-grid div {
    display: grid;
    gap: 0.75rem;
    border-top: 1px solid var(--line);
    padding-top: 1.25rem;
  }
  .fact-grid dt {
    color: var(--muted);
  }
  .fact-grid dd {
    font-size: var(--fs-xl);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }
</style>
