---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ProjectShowcase from '../components/ProjectShowcase.astro';
import CallToAction from '../components/CallToAction.astro';
import { content, langOf, localize } from '../i18n';

const lang = langOf(Astro.url);
const { industries, projects, workCategories } = content(lang);

const t = {
  en: {
    title: 'Projects',
    seoTitle: 'Example Projects: Websites, Apps & AI Automation | DeepTek',
    description: 'Examples of the websites, apps, IT and AI automation DeepTek builds for restaurants, cafes, retail and other businesses in the UAE and GCC.',
    label: 'Projects',
    heading: 'Practical work with measurable outcomes.',
    lead: 'These examples show the kind of problems we solve for businesses like yours. Client case studies are shared only with each client’s permission.',
    catNav: 'Work categories',
    count: (n: number) => `${n} ${n === 1 ? 'project' : 'projects'}`,
    sectorsLabel: 'Who we work with',
    sectorsHeading: 'For every kind of business, big or small.',
    sectorsLead: 'Most of our clients are small and growing businesses. Here is what we typically do for each.',
    sectorsCta: 'Don’t see your business here? We can still help businesses like yours.',
    sectorsButton: 'Tell us about it',
    cta: 'Could your project be next?',
  },
  ar: {
    title: 'المشاريع',
    seoTitle: 'نماذج مشاريع: مواقع وتطبيقات وأتمتة بالذكاء الاصطناعي | DeepTek',
    description: 'أمثلة على المواقع والتطبيقات وحلول تقنية المعلومات والأتمتة بالذكاء الاصطناعي التي تقدمها DeepTek للمطاعم والمقاهي ومتاجر التجزئة وغيرها في الإمارات والخليج.',
    label: 'المشاريع',
    heading: 'أعمال عملية بنتائج قابلة للقياس.',
    lead: 'توضح هذه الأمثلة نوع المشكلات التي نحلها لأعمال مثل أعمالك. لا ننشر دراسات حالة عملائنا إلا بإذن كل عميل.',
    catNav: 'فئات الأعمال',
    count: (n: number) => (n === 1 ? 'مشروع واحد' : n === 2 ? 'مشروعان' : `${n} مشاريع`),
    sectorsLabel: 'من نخدم',
    sectorsHeading: 'لكل أنواع الأعمال، كبيرة كانت أو صغيرة.',
    sectorsLead: 'معظم عملائنا شركات صغيرة ونامية. هذا ما نقدمه عادةً لكل منها.',
    sectorsCta: 'لا ترى نشاطك هنا؟ يمكننا مساعدة أعمال مثل أعمالك أيضاً.',
    sectorsButton: 'أخبرنا عنه',
    cta: 'هل سيكون مشروعك هو التالي؟',
  },
}[lang];

const groups = workCategories
  .map((c) => ({ ...c, items: projects.filter((p) => p.category === c.id) }))
  .filter((g) => g.items.length > 0);
const position = (slug: string) => projects.findIndex((p) => p.slug === slug);

---

<Base title={t.title} seoTitle={t.seoTitle} description={t.description}>
  <PageHero
    label={t.label}
    title={t.heading}
    lead={t.lead}
  />

  <nav class="cat-nav" aria-label={t.catNav}>
    <div class="container">
      <ul role="list">
        {
          groups.map((g, i) => (
            <li>
              <a href={`#${g.id}`}>
                <span class="mono">{String(i + 1).padStart(2, '0')}</span>
                {g.title}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>

  {
    groups.map((g, i) => (
      <section class="cat section" id={g.id} aria-labelledby={`${g.id}-title`}>
        <div class="container">
          <header class="cat-head">
            <span class="cat-index" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <div class="cat-text">
              <h2 id={`${g.id}-title`} data-split>
                {g.title}
              </h2>
              <p class="lead" data-reveal>
                {g.lead}
              </p>
            </div>
            <span class="mono cat-count" data-reveal>
              {t.count(g.items.length)}
            </span>
          </header>
          <div class="showcases">
            {g.items.map((p) => (
              <ProjectShowcase project={p} index={position(p.slug)} detailed />
            ))}
          </div>
        </div>
      </section>
    ))
  }

  <section class="section theme-night sectors" aria-labelledby="sectors-title">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{t.sectorsLabel}</p>
        <h2 id="sectors-title" data-split>{t.sectorsHeading}</h2>
        <p class="lead" data-reveal>{t.sectorsLead}</p>
      </div>
      <ul class="sector-grid" role="list" data-reveal-stagger>
        {
          industries.map((s, i) => (
            <li>
              <span class="mono">{String(i + 1).padStart(2, '0')}</span>
              <h3>{s.name}</h3>
              <p class="ex">{s.examples}</p>
              <p>{s.does}</p>
            </li>
          ))
        }
      </ul>
      <div class="sector-cta" data-reveal>
        <p>{t.sectorsCta}</p>
        <a class="btn" href={localize('/contact/', lang)}>{t.sectorsButton} <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <CallToAction heading={t.cta} />
</Base>

<script>
  // Highlight the category currently on screen in the sticky navigation.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.cat-nav a')];
  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        links.forEach((a) => {
          const on = a.hash === `#${e.target.id}`;
          if (on) {
            a.setAttribute('aria-current', 'true');
            a.scrollIntoView({ block: 'nearest', inline: 'nearest' });
          } else a.removeAttribute('aria-current');
        });
      });
    },
    { rootMargin: '-40% 0px -55% 0px' },
  );
  document.querySelectorAll('.cat').forEach((s) => io.observe(s));
</script>

<style>
  .cat-nav {
    position: sticky;
    top: var(--header-h);
    z-index: 20;
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  /* No blur on phones and tablets: it is repainted on every scroll frame. */
  @media (max-width: 63.99rem), (hover: none) {
    .cat-nav {
      background: var(--paper);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
  }
  .cat-nav ul {
    display: flex;
    gap: 0.5rem;
    padding-block: 0.75rem;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .cat-nav ul::-webkit-scrollbar {
    display: none;
  }
  .cat-nav a {
    display: inline-flex;
    gap: 0.5rem;
    align-items: baseline;
    padding: 0.5rem 1rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: var(--fs-sm);
    font-weight: 500;
    white-space: nowrap;
    text-decoration: none;
    transition:
      background-color 0.3s var(--ease),
      color 0.3s var(--ease),
      border-color 0.3s var(--ease);
  }
  .cat-nav a:hover,
  .cat-nav a[aria-current='true'] {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }
  .cat-nav a .mono {
    color: inherit;
    opacity: 0.6;
  }

  .cat {
    scroll-margin-top: calc(var(--header-h) + 3.5rem);
  }
  .cat + .cat {
    border-top: 1px solid var(--line);
  }
  .cat-head {
    display: grid;
    gap: 1.25rem;
    margin-bottom: clamp(3rem, 7vw, 6rem);
  }
  @media (min-width: 56rem) {
    .cat-head {
      grid-template-columns: 1fr 3fr auto;
      align-items: start;
    }
  }
  .cat-index {
    font-size: clamp(3rem, 7vw, 6rem);
    font-weight: 500;
    letter-spacing: -0.06em;
    line-height: 0.85;
    color: var(--muted);
  }
  .cat-text {
    display: grid;
    gap: 1.25rem;
  }
  .cat-text h2 {
    font-size: var(--fs-2xl);
    max-width: 16ch;
  }
  .cat-count {
    color: var(--muted);
    padding-top: 0.5rem;
  }
  .showcases {
    display: grid;
    gap: clamp(4.5rem, 11vw, 9rem);
  }
  .sectors .lead {
    color: var(--muted);
    font-size: var(--fs-lg);
    max-width: 40ch;
  }
  .sector-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    border-top: 1px solid var(--line);
    border-inline-start: 1px solid var(--line);
  }
  .sector-grid li {
    display: grid;
    align-content: start;
    gap: 0.6rem;
    padding: clamp(1.25rem, 2.5vw, 2rem);
    border-bottom: 1px solid var(--line);
    border-inline-end: 1px solid var(--line);
  }
  .sector-grid .mono {
    color: var(--muted);
    margin-bottom: 1.25rem;
  }
  .sector-grid h3 {
    font-size: var(--fs-lg);
    letter-spacing: -0.02em;
  }
  .sector-grid .ex {
    font-size: var(--fs-sm);
    color: inherit;
  }
  .sector-grid p {
    color: var(--muted);
    font-size: var(--fs-sm);
    line-height: 1.55;
  }
  .sector-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }
  .sector-cta p {
    font-size: var(--fs-lg);
    max-width: 36ch;
  }
</style>
